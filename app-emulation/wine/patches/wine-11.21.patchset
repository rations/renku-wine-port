+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <windows.h>
+
+#include <windows.h>
+
+LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
+
+1 RT_MANIFEST rundll32.manifest
diff --git a/programs/rundll32/rundll32.manifest b/programs/rundll32/rundll32.manifest
new file mode 100644
index 00000000..07b215a1
--- /dev/null
+++ b/programs/rundll32/rundll32.manifest
