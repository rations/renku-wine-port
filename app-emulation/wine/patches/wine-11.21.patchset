diff --git a/dlls/winerenku.drv/be_window.cpp b/dlls/winerenku.drv/be_window.cpp
index b26d307c..adc01a7e 100644
--- a/dlls/winerenku.drv/be_window.cpp
+++ b/dlls/winerenku.drv/be_window.cpp
@@ -32,6 +32,7 @@
 #include <View.h>
 #include <Window.h>
 
+#include <map>
 #include <math.h>
 
 /* Win32 threads never lock a BWindow: they post a message to it through a BMessenger, which
@@ -50,6 +51,14 @@ struct be_window
     int32 refs;
 };
 
+/* A layer is addressed by its id: the view itself lives on the window's looper, which may
+ * have deleted it (with the window) by the time a message arrives. */
+struct be_layer
+{
+    BMessenger messenger;
+    int32 id;
+};
+
 namespace {
 
 enum
@@ -64,8 +73,14 @@ enum
     MSG_SET_BITMAP  = 'rBmp',
     MSG_INVALIDATE  = 'rInv',
     MSG_DESTROY     = 'rDel',
+    MSG_LAYER_NEW   = 'rLNw',
+    MSG_LAYER_FRAME = 'rLFr',
+    MSG_LAYER_BITMAP = 'rLBm',
+    MSG_LAYER_DELETE = 'rLDl',
 };
 
+int32 next_layer_id;
+
 /* Win32 rectangles exclude right and bottom, BRect includes them. */
 BRect to_brect(const struct be_rect *r)
 {
@@ -111,21 +126,20 @@ void bitmap_release(struct be_bitmap *bitmap)
     }
 }
 
-/* Shows the window surface's bitmap. win32u has already drawn the whole window into it,
- * non-client area included, so there is nothing else to draw. */
-class RenkuView : public BView
+/* A view that draws one bitmap (or nothing) with its top-left pixel at an origin, and
+ * passes the mouse to Wine. Owns a reference to the bitmap. */
+class RenkuBitmapView : public BView
 {
 public:
-    RenkuView(BRect frame, uint64 cookie)
-        : BView(frame, "wine", B_FOLLOW_ALL, B_WILL_DRAW), fBitmap(NULL), fOrigin(0, 0),
+    RenkuBitmapView(BRect frame, const char *name, uint32 resizing, uint64 cookie)
+        : BView(frame, name, resizing, B_WILL_DRAW), fBitmap(NULL), fOrigin(0, 0),
           fCookie(cookie), fButtons(0)
     {
         /* app_server must not clear the update area first: Draw() covers it. */
         SetViewColor(B_TRANSPARENT_COLOR);
-        SetLowColor(255, 255, 255);
     }
 
-    ~RenkuView() override
+    ~RenkuBitmapView() override
     {
         bitmap_release(fBitmap);
     }
@@ -223,6 +237,40 @@ private:
     uint32 fButtons;
 };
 
+/* Shows the window surface's bitmap. win32u has already drawn the whole window into it,
+ * non-client area included, so there is nothing else to draw. */
+class RenkuView : public RenkuBitmapView
+{
+public:
+    RenkuView(BRect frame, uint64 cookie)
+        : RenkuBitmapView(frame, "wine", B_FOLLOW_ALL, cookie)
+    {
+        SetLowColor(255, 255, 255);
+    }
+};
+
+/* A layer: a child of the surface view that shows the frames of an OpenGL client surface at
+ * the client area of its window. app_server keeps the surface view's drawing out of it (no
+ * B_DRAW_ON_CHILDREN), and it takes the mouse there, passing it on like the surface view.
+ * Created hidden; the first frame shows it. */
+class RenkuLayerView : public RenkuBitmapView
+{
+public:
+    RenkuLayerView(uint64 cookie)
+        : RenkuBitmapView(BRect(0, 0, 0, 0), "wine-gl", B_FOLLOW_NONE, cookie)
+    {
+        SetLowColor(0, 0, 0);
+        Hide();
+    }
+
+    /* Shown first: an Invalidate() of a hidden view draws nothing. */
+    void ShowBitmap(struct be_bitmap *bitmap)
+    {
+        if (IsHidden()) Show();
+        SetBitmap(bitmap, BPoint(0, 0));
+    }
+};
+
 class RenkuWindow : public BWindow
 {
 public:
@@ -385,6 +433,48 @@ public:
             fView->Invalidate(rect);
             return;
         }
+        case MSG_LAYER_NEW:
+        {
+            RenkuLayerView *layer;
+            int32 id;
+            if (msg->FindInt32("id", &id) != B_OK) break;
+            layer = new RenkuLayerView(fCookie);
+            fView->AddChild(layer);
+            fLayers[id] = layer;
+            return;
+        }
+        case MSG_LAYER_FRAME:
+        {
+            RenkuLayerView *layer;
+            BRect frame;
+            int32 id;
+            if (msg->FindInt32("id", &id) != B_OK || msg->FindRect("frame", &frame) != B_OK) break;
+            if (!(layer = FindLayer(id))) return;
+            layer->MoveTo(frame.LeftTop());
+            layer->ResizeTo(frame.Width(), frame.Height());
+            return;
+        }
+        case MSG_LAYER_BITMAP:
+        {
+            RenkuLayerView *layer;
+            void *bitmap = NULL;
+            int32 id;
+            if (msg->FindInt32("id", &id) != B_OK || msg->FindPointer("bitmap", &bitmap) != B_OK) break;
+            if (!(layer = FindLayer(id))) bitmap_release((struct be_bitmap *)bitmap);
+            else layer->ShowBitmap((struct be_bitmap *)bitmap);
+            return;
+        }
+        case MSG_LAYER_DELETE:
+        {
+            RenkuLayerView *layer;
+            int32 id;
+            if (msg->FindInt32("id", &id) != B_OK) break;
+            if (!(layer = FindLayer(id))) return;
+            fLayers.erase(id);
+            layer->RemoveSelf();
+            delete layer;
+            return;
+        }
         case MSG_DESTROY:
             /* On the looper thread, with the window locked: Quit() deletes the window, and
              * the view's destructor drops its bitmap. Wine posts nothing after this. The
@@ -397,6 +487,12 @@ public:
     }
 
 private:
+    RenkuLayerView *FindLayer(int32 id)
+    {
+        std::map<int32, RenkuLayerView *>::iterator it = fLayers.find(id);
+        return it == fLayers.end() ? NULL : it->second;
+    }
+
     void FrameChanged()
     {
         struct be_event event = {};
@@ -406,6 +502,7 @@ private:
     }
 
     RenkuView *fView;
+    std::map<int32, RenkuLayerView *> fLayers;  /* deleted with fView, their parent */
     uint64 fCookie;
     bool fActive;
     bool fFramePending;  /* a BE_EVENT_FRAME is queued and Wine has not asked yet */
@@ -449,6 +546,11 @@ extern "C" void be_bitmap_release(struct be_bitmap *bitmap)
     bitmap_release(bitmap);
 }
 
+extern "C" int be_bitmap_in_use(struct be_bitmap *bitmap)
+{
+    return atomic_get(&bitmap->refs) > 1;
+}
+
 extern "C" struct be_window *be_window_create(enum be_window_style style, unsigned int flags,
                                               const struct be_rect *frame, const char *title_utf8,
                                               uint64_t cookie)
@@ -565,3 +667,48 @@ extern "C" void be_window_invalidate(struct be_window *window, const struct be_r
     msg.AddRect("rect", to_brect(rect));
     post(window, &msg);
 }
+
+extern "C" struct be_layer *be_layer_create(struct be_window *window)
+{
+    struct be_layer *layer;
+
+    if (!window) return NULL;
+    layer = new struct be_layer;
+    layer->messenger = window->messenger;
+    layer->id = atomic_add(&next_layer_id, 1);
+    BMessage msg(MSG_LAYER_NEW);
+    msg.AddInt32("id", layer->id);
+    if (layer->messenger.SendMessage(&msg) != B_OK)
+    {
+        delete layer;
+        return NULL;
+    }
+    return layer;
+}
+
+extern "C" void be_layer_set_frame(struct be_layer *layer, const struct be_rect *frame)
+{
+    BMessage msg(MSG_LAYER_FRAME);
+    msg.AddInt32("id", layer->id);
+    msg.AddRect("frame", to_brect(frame));
+    layer->messenger.SendMessage(&msg);
+}
+
+extern "C" void be_layer_set_bitmap(struct be_layer *layer, struct be_bitmap *bitmap)
+{
+    BMessage msg(MSG_LAYER_BITMAP);
+
+    atomic_add(&bitmap->refs, 1);  /* handed to the view with the message */
+    msg.AddInt32("id", layer->id);
+    msg.AddPointer("bitmap", bitmap);
+    if (layer->messenger.SendMessage(&msg) != B_OK) bitmap_release(bitmap);
+}
+
+extern "C" void be_layer_destroy(struct be_layer *layer)
+{
+    if (!layer) return;
+    BMessage msg(MSG_LAYER_DELETE);
+    msg.AddInt32("id", layer->id);
+    layer->messenger.SendMessage(&msg);
+    delete layer;
+}
diff --git a/dlls/winerenku.drv/opengl.c b/dlls/winerenku.drv/opengl.c
new file mode 100644
index 00000000..d7e5f28c
--- /dev/null
+++ b/dlls/winerenku.drv/opengl.c
@@ -0,0 +1,786 @@
+/*
+ * RenkuOS driver: OpenGL through OSMesa (software, llvmpipe)
+ *
+ * Copyright 2020 Alexandros Frantzis for Collabora Ltd. (winewayland.drv's opengl.c, whose
+ *                structure this follows)
+ * Copyright 2026 rations
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* Mesa on RenkuOS has no DRI swrast module and no EGL platform Wine can use: eglInitialize
+ * fails (docs/probes/eglprobe.c in the port repository). It does ship OSMesa, which gives a
+ * windowless desktop GL 4.5 compatibility context on llvmpipe (docs/probes/osprobe.c). So GL
+ * renders into a plain memory buffer, and a swap shows that buffer in the window.
+ *
+ * Presenting: a window with GL is shown through a view of its own in its top-level's BWindow
+ * when nothing clips it, otherwise drawn into its window with GDI; see renku_client_surface
+ * below. Either way a plug-in editor's GL child window shows in place, in its native window.
+ *
+ * The backend plugs into win32u only through struct opengl_driver_funcs. It sets no
+ * p_init_egl_platform, so win32u runs no EGL initialization (init_egl_platforms,
+ * dlls/win32u/opengl.c). The port configures --without-opengl, so win32u does not load
+ * libEGL either. */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <dlfcn.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "renku.h"
+#include "wine/opengl_driver.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(renkudrv);
+
+/* The client surface of a window that has a GL drawable.
+ *
+ * Its frames are shown in one of two ways, chosen again on every update (win32u updates a
+ * client surface whenever a window of its top-level moves, and before every present):
+ *
+ * - A layer, a view of its own in the top-level's BWindow at the window's client area
+ *   (be_layer_create). A frame is copied into a BBitmap and handed to the view, and app_server
+ *   shows it at once. Used when the window is shown in full: its top-level has a BWindow on
+ *   screen, no DPI scaling applies, and nothing clips its client area (no overlapping sibling,
+ *   child or parent edge), since a view would cover whatever Win32 window lies above it.
+ * - Otherwise offscreen: win32u hands present() a DC on the window, and the frame is drawn into
+ *   it with GDI, which clips it and puts it into the top-level's window surface. It reaches
+ *   the screen with that surface's next flush: when a thread of the process waits for
+ *   messages, or 50 ms into continuous drawing (FLUSH_PERIOD, dlls/win32u/dibdrv/dc.c).
+ *
+ * win32u calls every function here with its client surface lock held (dlls/win32u/window.c),
+ * so they never run at the same time for one surface. bits is set only during a present. */
+#define LAYER_BITMAPS 3
+
+struct renku_client_surface
+{
+    struct client_surface client;
+    struct be_window     *window;   /* the top-level's BWindow the layer is in, referenced */
+    struct be_layer      *layer;    /* NULL while offscreen */
+    struct be_bitmap     *bitmaps[LAYER_BITMAPS];  /* frames handed to the layer, reused */
+    SIZE                  bitmap_sizes[LAYER_BITMAPS];
+    int                   last;     /* index of the bitmap handed over last, -1 for none */
+    const void           *bits;     /* top row first, B, G, R, A per pixel */
+    int                   width, height;
+};
+
+static struct renku_client_surface *impl_from_client_surface(struct client_surface *client)
+{
+    return CONTAINING_RECORD(client, struct renku_client_surface, client);
+}
+
+/**********************************************************************
+ *          client surfaces
+ */
+static void release_layer(struct renku_client_surface *surface)
+{
+    int i;
+
+    be_layer_destroy(surface->layer);
+    surface->layer = NULL;
+    if (surface->window) be_window_release(surface->window);
+    surface->window = NULL;
+    for (i = 0; i < LAYER_BITMAPS; i++)
+    {
+        if (surface->bitmaps[i]) be_bitmap_release(surface->bitmaps[i]);
+        surface->bitmaps[i] = NULL;
+    }
+    surface->last = -1;
+}
+
+/* Whether the window's client area is clipped (needs_client_window_clipping in winex11.drv):
+ * the visible region of a DC on it, in screen coordinates, is not one rectangle the size of
+ * the client area. */
+static BOOL client_area_clipped(HWND hwnd, const RECT *client)
+{
+    RECT box;
+    HRGN region;
+    HDC hdc;
+    INT ret = ERROR;
+
+    if (!(hdc = NtUserGetDCEx(hwnd, 0, DCX_CACHE | DCX_USESTYLE))) return TRUE;
+    if ((region = NtGdiCreateRectRgn(0, 0, 0, 0)))
+    {
+        if (NtGdiGetRandomRgn(hdc, region, SYSRGN) > 0) ret = NtGdiGetRgnBox(region, &box);
+        NtGdiDeleteObjectApp(region);
+    }
+    NtUserReleaseDC(hwnd, hdc);
+
+    return ret != SIMPLEREGION || box.right - box.left != client->right - client->left ||
+           box.bottom - box.top != client->bottom - client->top;
+}
+
+/* The BWindow a layer for this surface can go in, referenced; NULL to draw offscreen. */
+static struct be_window *layer_window_for(struct client_surface *client)
+{
+    HWND hwnd = client->hwnd;
+    struct be_window *window;
+    RECT rect = client->virtual_rect;
+
+    if (IsRectEmpty(&rect)) return NULL;
+    if (!client->raw && NtUserGetDpiForWindow(hwnd) != NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI))
+        return NULL;  /* needs scaling */
+    if (!(window = renku_window_get(client->toplevel))) return NULL;
+    if (client_area_clipped(hwnd, &rect))
+    {
+        be_window_release(window);
+        return NULL;
+    }
+    return window;
+}
+
+static void renku_client_surface_destroy(struct client_surface *client)
+{
+    TRACE("%s\n", debugstr_client_surface(client));
+    release_layer(impl_from_client_surface(client));
+}
+
+static void renku_client_surface_detach(struct client_surface *client)
+{
+    TRACE("%s\n", debugstr_client_surface(client));
+    release_layer(impl_from_client_surface(client));
+}
+
+static void renku_client_surface_update(struct client_surface *client)
+{
+    struct renku_client_surface *surface = impl_from_client_surface(client);
+    struct be_window *window = layer_window_for(client);
+    struct be_rect frame;
+
+    if (window != surface->window)
+    {
+        TRACE("%s: %s\n", debugstr_client_surface(client), window ? "layer" : "offscreen");
+        release_layer(surface);
+        if (window && !(surface->layer = be_layer_create(window)))
+        {
+            be_window_release(window);
+            window = NULL;
+        }
+        surface->window = window;
+    }
+    else if (window) be_window_release(window);  /* the surface holds one already */
+
+    InterlockedExchange(&client->offscreen, !surface->layer);
+    if (!surface->layer) return;
+
+    /* virtual_rect is relative to the top-level's visible rect, which is the BWindow's frame. */
+    frame.left = client->virtual_rect.left;
+    frame.top = client->virtual_rect.top;
+    frame.right = client->virtual_rect.right;
+    frame.bottom = client->virtual_rect.bottom;
+    TRACE("%s: layer at %s\n", debugstr_client_surface(client), wine_dbgstr_rect(&client->virtual_rect));
+    be_layer_set_frame(surface->layer, &frame);
+}
+
+/* Slot i, at the frame's size: kept if it has that size, otherwise replaced. Replacing only
+ * drops the surface's reference, so a bitmap the layer still shows lives on until it is done. */
+static struct be_bitmap *layer_bitmap_slot(struct renku_client_surface *surface, int i)
+{
+    if (surface->bitmaps[i])
+    {
+        if (surface->bitmap_sizes[i].cx == surface->width && surface->bitmap_sizes[i].cy == surface->height)
+            return surface->bitmaps[i];
+        be_bitmap_release(surface->bitmaps[i]);
+        surface->bitmaps[i] = NULL;
+    }
+    if (!(surface->bitmaps[i] = be_bitmap_create(surface->width, surface->height))) return NULL;
+    surface->bitmap_sizes[i].cx = surface->width;
+    surface->bitmap_sizes[i].cy = surface->height;
+    return surface->bitmaps[i];
+}
+
+/* The slot for the next frame: one the layer no longer holds. If the window's looper is
+ * LAYER_BITMAPS frames behind, the one handed over last: it is drawn into again and handed over
+ * again, so the newest frame is always the one that stays on screen (a frame dropped instead
+ * would leave an older one there once the program stops drawing). It may show torn for a
+ * moment, if app_server is drawing it as it is written. */
+static int layer_slot(struct renku_client_surface *surface)
+{
+    int i;
+
+    for (i = 0; i < LAYER_BITMAPS; i++)
+        if (!surface->bitmaps[i] || !be_bitmap_in_use(surface->bitmaps[i])) return i;
+    return surface->last >= 0 ? surface->last : 0;
+}
+
+static void present_to_layer(struct renku_client_surface *surface)
+{
+    int slot = layer_slot(surface), y, stride;
+    const char *src = surface->bits;
+    struct be_bitmap *bitmap;
+    char *dst;
+
+    if (!(bitmap = layer_bitmap_slot(surface, slot)))
+    {
+        WARN("%s: no %dx%d bitmap, frame dropped\n", debugstr_client_surface(&surface->client),
+             surface->width, surface->height);
+        return;
+    }
+    dst = be_bitmap_bits(bitmap, &stride);
+    for (y = 0; y < surface->height; y++, src += surface->width * 4, dst += stride)
+        memcpy(dst, src, surface->width * 4);
+    be_layer_set_bitmap(surface->layer, bitmap);
+    surface->last = slot;
+}
+
+/* hdc is a DC on the client area of the surface's window when it is offscreen, NULL when it
+ * has a layer. Offscreen, the frame is stretched only if the window's size in virtual
+ * coordinates differs from the buffer's, which happens only for a raw (monitor-sized) surface
+ * under DPI scaling. */
+static void renku_client_surface_present(struct client_surface *client, HDC hdc)
+{
+    struct renku_client_surface *surface = impl_from_client_surface(client);
+    int width = client->virtual_rect.right - client->virtual_rect.left;
+    int height = client->virtual_rect.bottom - client->virtual_rect.top;
+    BITMAPINFO info;
+
+    if (!surface->bits) return;
+    if (!hdc)
+    {
+        if (surface->layer) present_to_layer(surface);
+        return;
+    }
+
+    memset(&info, 0, sizeof(info));
+    info.bmiHeader.biSize        = sizeof(info.bmiHeader);
+    info.bmiHeader.biWidth       = surface->width;
+    info.bmiHeader.biHeight      = -surface->height; /* top-down */
+    info.bmiHeader.biPlanes      = 1;
+    info.bmiHeader.biBitCount    = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    info.bmiHeader.biSizeImage   = surface->width * 4 * surface->height;
+
+    TRACE("%s %dx%d to %dx%d\n", debugstr_client_surface(client), surface->width, surface->height,
+          width, height);
+    NtGdiStretchDIBitsInternal(hdc, 0, 0, width, height, 0, 0, surface->width, surface->height,
+                               surface->bits, &info, DIB_RGB_COLORS, SRCCOPY, sizeof(info),
+                               info.bmiHeader.biSizeImage, 0);
+}
+
+static const struct client_surface_funcs renku_client_surface_funcs =
+{
+    .size = sizeof(struct renku_client_surface),
+    .destroy = renku_client_surface_destroy,
+    .detach = renku_client_surface_detach,
+    .update = renku_client_surface_update,
+    .present = renku_client_surface_present,
+};
+
+/***********************************************************************
+ *          RENKU_CreateClientSurface
+ */
+struct client_surface *RENKU_CreateClientSurface(HWND hwnd, int format, BOOL raw)
+{
+    struct renku_client_surface *surface;
+
+    if (!(surface = client_surface_create(&renku_client_surface_funcs, hwnd, format, raw))) return NULL;
+    /* Offscreen until the first update finds it a layer. */
+    surface->client.offscreen = TRUE;
+    surface->last = -1;
+    TRACE("hwnd %p, format %d, raw %u -> %s\n", hwnd, format, raw, debugstr_client_surface(&surface->client));
+    return &surface->client;
+}
+
+#ifdef SONAME_LIBOSMESA
+
+/* OSMesa's constants and context type, from GL/osmesa.h (Mesa 22.0.5, as installed on RenkuOS
+ * by mesa_devel). The header itself is not included: it includes the system GL/gl.h, which
+ * clashes with wine/wgl.h (both define the GL types and enums). libOSMesa is dlopen()ed, so
+ * only these few values are needed. */
+typedef struct osmesa_context *OSMesaContext;
+#define OSMESA_BGRA                   0x1
+#define OSMESA_Y_UP                   0x11
+#define OSMESA_FORMAT                 0x22
+#define OSMESA_DEPTH_BITS             0x30
+#define OSMESA_STENCIL_BITS           0x31
+#define OSMESA_ACCUM_BITS             0x32
+#define OSMESA_PROFILE                0x33
+#define OSMESA_CORE_PROFILE           0x34
+#define OSMESA_COMPAT_PROFILE         0x35
+#define OSMESA_CONTEXT_MAJOR_VERSION  0x36
+#define OSMESA_CONTEXT_MINOR_VERSION  0x37
+
+/* Largest pbuffer side advertised and accepted (also the cap for "largest"). */
+#define OSMESA_MAX_PBUFFER_SIZE 4096
+
+static const struct opengl_funcs *funcs;
+static const struct opengl_drawable_funcs osmesa_surface_funcs;
+static const struct opengl_drawable_funcs osmesa_pbuffer_funcs;
+
+static void *osmesa_handle;
+static OSMesaContext (*p_OSMesaCreateContextAttribs)(const int *, OSMesaContext);
+static OSMesaContext (*p_OSMesaCreateContextExt)(GLenum, GLint, GLint, GLint, OSMesaContext);
+static void (*p_OSMesaDestroyContext)(OSMesaContext);
+static GLboolean (*p_OSMesaMakeCurrent)(OSMesaContext, void *, GLenum, GLsizei, GLsizei);
+static OSMesaContext (*p_OSMesaGetCurrentContext)(void);
+static GLboolean (*p_OSMesaGetColorBuffer)(OSMesaContext, GLint *, GLint *, GLint *, void **);
+static void (*p_OSMesaPixelStore)(GLint, GLint);
+static void *(*p_OSMesaGetProcAddress)(const char *);
+
+struct osmesa_drawable
+{
+    struct opengl_drawable base;
+    int    width, height;
+    void  *buffer;                  /* width * height * 4, the OSMesa render target */
+};
+
+static struct osmesa_drawable *impl_from_opengl_drawable(struct opengl_drawable *base)
+{
+    return CONTAINING_RECORD(base, struct osmesa_drawable, base);
+}
+
+/**********************************************************************
+ *          drawables
+ */
+
+/* If the context current on this thread renders into old_buffer, point it at gl's new
+ * buffer, so llvmpipe never keeps writing into freed memory (a resize while current). */
+static BOOL osmesa_rebind_if_current(void *old_buffer, struct osmesa_drawable *gl)
+{
+    OSMesaContext ctx = p_OSMesaGetCurrentContext();
+    GLint width, height, format;
+    void *bound = NULL;
+
+    if (!ctx || !p_OSMesaGetColorBuffer(ctx, &width, &height, &format, &bound)) return TRUE;
+    if (bound != old_buffer) return TRUE;
+
+    if (!p_OSMesaMakeCurrent(ctx, gl->buffer, GL_UNSIGNED_BYTE, gl->width, gl->height))
+    {
+        ERR("OSMesaMakeCurrent failed after a resize\n");
+        return FALSE;
+    }
+    p_OSMesaPixelStore(OSMESA_Y_UP, 0);
+    return TRUE;
+}
+
+static BOOL osmesa_drawable_resize(struct osmesa_drawable *gl, SIZE size)
+{
+    int width = max(size.cx, 1), height = max(size.cy, 1);
+    void *old_buffer = gl->buffer, *buffer;
+
+    if (gl->buffer && width == gl->width && height == gl->height) return TRUE;
+
+    /* A new buffer, not a realloc() in place: a bound context still points at the old one
+     * until it is rebound below. */
+    if (!(buffer = calloc(1, (size_t)width * height * 4))) return FALSE;
+    gl->buffer = buffer;
+    gl->width = width;
+    gl->height = height;
+
+    if (old_buffer)
+    {
+        osmesa_rebind_if_current(old_buffer, gl);
+        free(old_buffer);
+    }
+    return TRUE;
+}
+
+static SIZE osmesa_drawable_size(struct osmesa_drawable *gl)
+{
+    if (gl->base.client && gl->base.client->raw) return gl->base.monitor_size;
+    return gl->base.virtual_size;
+}
+
+/* An OSMesa framebuffer has a single colour buffer, front left (osmesa_init_st_visual in
+ * Mesa), so a double-buffered format renders into it and a swap presents it. */
+static void osmesa_drawable_map_buffers(struct osmesa_drawable *gl)
+{
+    opengl_drawable_map_buffer(&gl->base, GL_BACK_LEFT, GL_FRONT_LEFT);
+    opengl_drawable_map_buffer(&gl->base, GL_BACK, GL_FRONT);
+    opengl_drawable_map_buffer(&gl->base, GL_FRONT_AND_BACK, GL_FRONT);
+}
+
+static void osmesa_drawable_destroy(struct opengl_drawable *base)
+{
+    struct osmesa_drawable *gl = impl_from_opengl_drawable(base);
+
+    TRACE("drawable %s\n", debugstr_opengl_drawable(base));
+    free(gl->buffer);
+}
+
+static void osmesa_present(struct osmesa_drawable *gl)
+{
+    struct renku_client_surface *surface = impl_from_client_surface(gl->base.client);
+
+    surface->bits = gl->buffer;
+    surface->width = gl->width;
+    surface->height = gl->height;
+    client_surface_present(&surface->client);
+    surface->bits = NULL;
+}
+
+static void osmesa_surface_flush(struct opengl_drawable *base, UINT flags)
+{
+    struct osmesa_drawable *gl = impl_from_opengl_drawable(base);
+
+    TRACE("drawable %s, flags %#x\n", debugstr_opengl_drawable(base), flags);
+
+    /* win32u has already put the new size in base. */
+    if (flags & GL_FLUSH_UPDATED) osmesa_drawable_resize(gl, osmesa_drawable_size(gl));
+
+    /* Front-buffer drawing flushed (opengl32 sets it only then, flush_context in
+     * dlls/opengl32/unix_wgl.c). */
+    if (flags & GL_FLUSH_PRESENT)
+    {
+        if (!(flags & GL_FLUSH_FINISHED)) funcs->p_glFinish();
+        osmesa_present(gl);
+    }
+}
+
+static BOOL osmesa_surface_swap(struct opengl_drawable *base)
+{
+    struct osmesa_drawable *gl = impl_from_opengl_drawable(base);
+
+    TRACE("drawable %s\n", debugstr_opengl_drawable(base));
+
+    /* llvmpipe must have finished writing the buffer before it is copied. */
+    funcs->p_glFinish();
+    osmesa_present(gl);
+    return TRUE;
+}
+
+static const struct opengl_drawable_funcs osmesa_surface_funcs =
+{
+    .size = sizeof(struct osmesa_drawable),
+    .destroy = osmesa_drawable_destroy,
+    .flush = osmesa_surface_flush,
+    .swap = osmesa_surface_swap,
+};
+
+static const struct opengl_drawable_funcs osmesa_pbuffer_funcs =
+{
+    .size = sizeof(struct osmesa_drawable),
+    .destroy = osmesa_drawable_destroy,
+};
+
+/**********************************************************************
+ *          driver functions
+ */
+static void *osmesa_get_proc_address(const char *name)
+{
+    void *proc = p_OSMesaGetProcAddress(name);
+    if (!proc) proc = dlsym(osmesa_handle, name);
+    return proc;
+}
+
+/* 32-bit BGRA, the layout of OSMESA_BGRA and of a 32-bpp BI_RGB DIB. */
+static const struct
+{
+    BYTE alpha_bits;
+    BYTE depth_bits;
+} osmesa_pixel_formats[] =
+{
+    { 8, 24 },
+    { 8, 16 },
+    { 0, 24 },
+};
+
+static UINT osmesa_init_pixel_formats(UINT *onscreen_count)
+{
+    *onscreen_count = ARRAY_SIZE(osmesa_pixel_formats);
+    return ARRAY_SIZE(osmesa_pixel_formats);
+}
+
+static BOOL osmesa_describe_pixel_format(int format, struct wgl_pixel_format *descr)
+{
+    if (format <= 0 || format > ARRAY_SIZE(osmesa_pixel_formats)) return FALSE;
+
+    memset(descr, 0, sizeof(*descr));
+    descr->pfd.nSize        = sizeof(descr->pfd);
+    descr->pfd.nVersion     = 1;
+    descr->pfd.dwFlags      = PFD_SUPPORT_OPENGL | PFD_DRAW_TO_WINDOW | PFD_DOUBLEBUFFER |
+                              PFD_GENERIC_FORMAT;
+    descr->pfd.iPixelType   = PFD_TYPE_RGBA;
+    descr->pfd.cColorBits   = 32;
+    descr->pfd.cRedBits     = 8;
+    descr->pfd.cRedShift    = 16;
+    descr->pfd.cGreenBits   = 8;
+    descr->pfd.cGreenShift  = 8;
+    descr->pfd.cBlueBits    = 8;
+    descr->pfd.cBlueShift   = 0;
+    descr->pfd.cAlphaBits   = osmesa_pixel_formats[format - 1].alpha_bits;
+    descr->pfd.cAlphaShift  = osmesa_pixel_formats[format - 1].alpha_bits ? 24 : 0;
+    descr->pfd.cDepthBits   = osmesa_pixel_formats[format - 1].depth_bits;
+    descr->pfd.cStencilBits = 8;
+    descr->pfd.iLayerType   = PFD_MAIN_PLANE;
+
+    /* The WGL pixel type, not the PFD one. PFD_TYPE_RGBA is 0, and opengl32 reads a zero
+     * pixel_type on the first format as "the driver gives no ARB attributes": it then calls
+     * a driver entry point that is never set, a null call. */
+    descr->pixel_type         = WGL_TYPE_RGBA_ARB;
+    descr->draw_to_pbuffer    = 1;
+    descr->max_pbuffer_width  = OSMESA_MAX_PBUFFER_SIZE;
+    descr->max_pbuffer_height = OSMESA_MAX_PBUFFER_SIZE;
+    descr->max_pbuffer_pixels = OSMESA_MAX_PBUFFER_SIZE * OSMESA_MAX_PBUFFER_SIZE;
+    return TRUE;
+}
+
+static void osmesa_init_extensions(struct opengl_funcs *funcs, BOOLEAN extensions[GL_EXTENSION_COUNT])
+{
+    /* No driver-specific WGL extensions; win32u adds its own. */
+}
+
+static struct opengl_context *osmesa_context_create(const struct opengl_context_attrs *attrs,
+                                                    struct opengl_context *share)
+{
+    OSMesaContext host_share = share ? share->host_context : NULL;
+    int os_attribs[16], *attr = os_attribs;
+    int profile = OSMESA_COMPAT_PROFILE;
+    struct opengl_context *context;
+    OSMesaContext ctx;
+
+    TRACE("attrs %s, share %p\n", debugstr_opengl_context_attrs(attrs), share);
+
+    if (attrs->profile & WGL_CONTEXT_ES2_PROFILE_BIT_EXT)
+    {
+        WARN("OpenGL ES contexts are not supported\n");
+        return NULL;
+    }
+    if (attrs->profile & WGL_CONTEXT_CORE_PROFILE_BIT_ARB) profile = OSMESA_CORE_PROFILE;
+    /* attrs->flags (debug, forward-compatible) and no_error have no OSMesa attribute, and
+     * OSMesaCreateContextAttribs rejects attributes it does not know. */
+
+    *attr++ = OSMESA_FORMAT;        *attr++ = OSMESA_BGRA;
+    *attr++ = OSMESA_DEPTH_BITS;    *attr++ = 24;
+    *attr++ = OSMESA_STENCIL_BITS;  *attr++ = 8;
+    *attr++ = OSMESA_ACCUM_BITS;    *attr++ = 0;
+    *attr++ = OSMESA_PROFILE;       *attr++ = profile;
+    if (attrs->major != -1)
+    {
+        *attr++ = OSMESA_CONTEXT_MAJOR_VERSION; *attr++ = attrs->major;
+        *attr++ = OSMESA_CONTEXT_MINOR_VERSION; *attr++ = attrs->minor != -1 ? attrs->minor : 0;
+    }
+    else if (profile == OSMESA_CORE_PROFILE)
+    {
+        /* OSMesa defaults to version 1.0, which no core profile has. 3.2 is the lowest core
+         * version, and Mesa still returns the highest it supports. */
+        *attr++ = OSMESA_CONTEXT_MAJOR_VERSION; *attr++ = 3;
+        *attr++ = OSMESA_CONTEXT_MINOR_VERSION; *attr++ = 2;
+    }
+    *attr = 0;
+
+    ctx = p_OSMesaCreateContextAttribs(os_attribs, host_share);
+    if (!ctx && profile == OSMESA_COMPAT_PROFILE && attrs->major == -1)
+        ctx = p_OSMesaCreateContextExt(OSMESA_BGRA, 24, 8, 0, host_share);
+    if (!ctx)
+    {
+        WARN("OSMesa context creation failed for attrs %s\n", debugstr_opengl_context_attrs(attrs));
+        return NULL;
+    }
+
+    if (!(context = calloc(1, sizeof(*context))))
+    {
+        p_OSMesaDestroyContext(ctx);
+        return NULL;
+    }
+    context->host_context = ctx;
+    TRACE("-> %p/%p\n", context, ctx);
+    return context;
+}
+
+static BOOL osmesa_context_destroy(struct opengl_context *context)
+{
+    TRACE("context %p\n", context);
+
+    if (context->host_context) p_OSMesaDestroyContext(context->host_context);
+    free(context);
+    return TRUE;
+}
+
+static BOOL osmesa_context_activate(struct opengl_context *context, struct opengl_drawable *draw_base,
+                                    struct opengl_drawable *read_base)
+{
+    struct osmesa_drawable *draw;
+
+    TRACE("context %p, draw %s, read %s\n", context, debugstr_opengl_drawable(draw_base),
+          debugstr_opengl_drawable(read_base));
+
+    if (!context || !context->host_context || !draw_base) return FALSE;
+    /* An OSMesa context renders into exactly one buffer, so reads come from the draw one. */
+    if (read_base && read_base != draw_base) FIXME("separate read drawable not supported\n");
+
+    draw = impl_from_opengl_drawable(draw_base);
+    if (!draw->buffer && !osmesa_drawable_resize(draw, osmesa_drawable_size(draw))) return FALSE;
+
+    if (!p_OSMesaMakeCurrent(context->host_context, draw->buffer, GL_UNSIGNED_BYTE,
+                             draw->width, draw->height))
+    {
+        ERR("OSMesaMakeCurrent failed\n");
+        return FALSE;
+    }
+    /* Top row first, like the DIB present() draws from: no vertical flip. */
+    p_OSMesaPixelStore(OSMESA_Y_UP, 0);
+    return TRUE;
+}
+
+static BOOL osmesa_cleanup_thread(void)
+{
+    /* OSMesaMakeCurrent(NULL, NULL, ...) unbinds (Mesa 22.0.5, osmesa.c). */
+    return p_OSMesaMakeCurrent(NULL, NULL, 0, 0, 0);
+}
+
+static struct osmesa_drawable *osmesa_offscreen_create(int format, SIZE size)
+{
+    struct osmesa_drawable *gl;
+
+    if (!(gl = opengl_drawable_create(&osmesa_pbuffer_funcs, format, NULL, &size))) return NULL;
+    osmesa_drawable_map_buffers(gl);
+    if (!osmesa_drawable_resize(gl, size))
+    {
+        opengl_drawable_release(&gl->base);
+        return NULL;
+    }
+    return gl;
+}
+
+static BOOL osmesa_surface_create(struct client_surface *client, int format, struct opengl_drawable **drawable)
+{
+    struct osmesa_drawable *gl;
+
+    TRACE("client %s, format %d\n", debugstr_client_surface(client), format);
+
+    /* win32u creates the client surface through the driver (get_unused_client_surface). */
+    if (client->funcs != &renku_client_surface_funcs)
+    {
+        ERR("unexpected client surface %s\n", debugstr_client_surface(client));
+        return FALSE;
+    }
+    if (!(gl = opengl_drawable_create(&osmesa_surface_funcs, format, client, NULL))) return FALSE;
+    osmesa_drawable_map_buffers(gl);
+    if (!osmesa_drawable_resize(gl, osmesa_drawable_size(gl)))
+    {
+        opengl_drawable_release(&gl->base);
+        return FALSE;
+    }
+
+    TRACE("created drawable %s\n", debugstr_opengl_drawable(&gl->base));
+    *drawable = &gl->base;
+    return TRUE;
+}
+
+static BOOL osmesa_pbuffer_create(HDC hdc, int format, SIZE size, BOOL largest, GLenum texture_format,
+                                  GLenum texture_target, GLint max_level, struct opengl_drawable **drawable)
+{
+    struct osmesa_drawable *gl;
+
+    TRACE("hdc %p, format %d, size %dx%d, largest %u\n", hdc, format, (int)size.cx, (int)size.cy, largest);
+
+    if (largest)
+    {
+        size.cx = min(size.cx, OSMESA_MAX_PBUFFER_SIZE);
+        size.cy = min(size.cy, OSMESA_MAX_PBUFFER_SIZE);
+    }
+    else if (size.cx > OSMESA_MAX_PBUFFER_SIZE || size.cy > OSMESA_MAX_PBUFFER_SIZE)
+        return FALSE;
+
+    if (!(gl = osmesa_offscreen_create(format, size))) return FALSE;
+    *drawable = &gl->base;
+    return TRUE;
+}
+
+/* win32u makes its internal root and thread contexts current on this when there is no
+ * drawable. OSMesa cannot bind a context without a buffer, so it is 1x1. */
+static BOOL osmesa_null_surface_create(int format, struct opengl_drawable **drawable)
+{
+    static const SIZE size = {1, 1};
+    struct osmesa_drawable *gl;
+
+    if (!(gl = osmesa_offscreen_create(format, size))) return FALSE;
+    *drawable = &gl->base;
+    return TRUE;
+}
+
+static const struct opengl_driver_funcs osmesa_driver_funcs =
+{
+    .p_get_proc_address      = osmesa_get_proc_address,
+    .p_init_pixel_formats    = osmesa_init_pixel_formats,
+    .p_describe_pixel_format = osmesa_describe_pixel_format,
+    .p_init_extensions       = osmesa_init_extensions,
+    .p_surface_create        = osmesa_surface_create,
+    .p_context_create        = osmesa_context_create,
+    .p_context_destroy       = osmesa_context_destroy,
+    .p_context_activate      = osmesa_context_activate,
+    .p_pbuffer_create        = osmesa_pbuffer_create,
+    .p_null_surface_create   = osmesa_null_surface_create,
+    .p_cleanup_thread        = osmesa_cleanup_thread,
+    /* Not verified that Mesa 22 shares objects between core and compatibility contexts;
+     * this makes win32u keep a root context per profile, so a context shares only with
+     * its own kind. */
+    .broken_sharing          = TRUE,
+};
+
+static BOOL osmesa_load(void)
+{
+    if (!(osmesa_handle = dlopen(SONAME_LIBOSMESA, RTLD_NOW | RTLD_GLOBAL)))
+    {
+        ERR("failed to load %s: %s\n", SONAME_LIBOSMESA, dlerror());
+        return FALSE;
+    }
+
+#define LOAD_FUNCPTR(f) \
+    if (!(p_##f = dlsym(osmesa_handle, #f))) { ERR("%s not found in %s\n", #f, SONAME_LIBOSMESA); goto failed; }
+    LOAD_FUNCPTR(OSMesaCreateContextAttribs)
+    LOAD_FUNCPTR(OSMesaCreateContextExt)
+    LOAD_FUNCPTR(OSMesaDestroyContext)
+    LOAD_FUNCPTR(OSMesaMakeCurrent)
+    LOAD_FUNCPTR(OSMesaGetCurrentContext)
+    LOAD_FUNCPTR(OSMesaGetColorBuffer)
+    LOAD_FUNCPTR(OSMesaPixelStore)
+    LOAD_FUNCPTR(OSMesaGetProcAddress)
+#undef LOAD_FUNCPTR
+    return TRUE;
+
+failed:
+    dlclose(osmesa_handle);
+    osmesa_handle = NULL;
+    return FALSE;
+}
+
+/***********************************************************************
+ *          RENKU_OpenGLInit
+ *
+ * Called once per process, when win32u first needs GL (display_funcs_init).
+ */
+UINT RENKU_OpenGLInit(UINT version, const struct opengl_funcs *opengl_funcs,
+                      const struct opengl_driver_funcs **driver_funcs)
+{
+    if (version != WINE_OPENGL_DRIVER_VERSION)
+    {
+        ERR("version mismatch, win32u wants %u but the driver has %u\n", version, WINE_OPENGL_DRIVER_VERSION);
+        return STATUS_INVALID_PARAMETER;
+    }
+    if (!osmesa_load()) return STATUS_NOT_SUPPORTED;
+
+    funcs = opengl_funcs;
+    *driver_funcs = &osmesa_driver_funcs;
+    TRACE("OpenGL through %s\n", SONAME_LIBOSMESA);
+    return STATUS_SUCCESS;
+}
+
+#else /* SONAME_LIBOSMESA */
+
+UINT RENKU_OpenGLInit(UINT version, const struct opengl_funcs *opengl_funcs,
+                      const struct opengl_driver_funcs **driver_funcs)
+{
+    ERR("built without OSMesa, no OpenGL\n");
+    return STATUS_NOT_SUPPORTED;
+}
+
+#endif /* SONAME_LIBOSMESA */
