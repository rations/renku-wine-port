+/* A Win32 thread waiting for a looper, which is allowed: loopers never wait for Win32
+ * threads. The timeout only guards against a looper that is gone or stuck. */
+extern "C" int be_window_get_frame(struct be_window *window, struct be_rect *frame)
+{
+    BMessage msg(MSG_GET_FRAME), reply;
+    BRect rect;
+
+    if (!window || window->messenger.SendMessage(&msg, &reply, B_INFINITE_TIMEOUT, 1000000) != B_OK ||
+        reply.FindRect("frame", &rect) != B_OK)
+        return -1;
+    /* BRect includes right and bottom, Win32 rectangles do not. */
+    frame->left = (int32_t)rect.left;
+    frame->top = (int32_t)rect.top;
+    frame->right = (int32_t)rect.right + 1;
+    frame->bottom = (int32_t)rect.bottom + 1;
+    return 0;
+}
