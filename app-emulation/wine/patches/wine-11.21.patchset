diff --git a/dlls/winerenku.drv/window.c b/dlls/winerenku.drv/window.c
new file mode 100644
index 00000000..8e499aee
--- /dev/null
+++ b/dlls/winerenku.drv/window.c
@@ -0,0 +1,308 @@
+/*
+ * RenkuOS driver: top-level windows
+ *
+ * Copyright 2026 rations
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <assert.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "renku.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(renkudrv);
+
+/* Only top-level windows (children of the desktop window) get a BWindow. win32u draws child
+ * windows into their top-level's surface, and message-only windows are never shown.
+ *
+ * Locking: win_data_mutex guards the tree and every renku_win_data. While it is held, the
+ * code calls only the be_window_* functions that post a message and win32u's reference
+ * increment; nothing that can take another lock. win32u calls the driver with its own locks
+ * held, so NtUser* queries, surface creation (a DIB section) and the release of a surface
+ * (which may free one) all happen with the mutex unlocked. Be threads never take it. */
+struct renku_win_data
+{
+    struct rb_entry        entry;
+    HWND                   hwnd;
+    struct be_window      *window;
+    enum be_window_style   style;
+    struct be_rect         frame;     /* the BWindow's frame as last set */
+    struct window_surface *surface;   /* the surface the BWindow draws, referenced */
+    BOOL                   visible;
+};
+
+static int win_data_cmp(const void *key, const struct rb_entry *entry)
+{
+    HWND hwnd = (HWND)key;
+    const struct renku_win_data *data = RB_ENTRY_VALUE(entry, const struct renku_win_data, entry);
+
+    if (hwnd < data->hwnd) return -1;
+    if (hwnd > data->hwnd) return 1;
+    return 0;
+}
+
+static pthread_mutex_t win_data_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct rb_tree win_data_tree = { win_data_cmp };
+
+/* Locks win_data_mutex and returns the data, or unlocks and returns NULL. */
+static struct renku_win_data *get_win_data(HWND hwnd)
+{
+    struct rb_entry *entry;
+
+    pthread_mutex_lock(&win_data_mutex);
+    if ((entry = rb_get(&win_data_tree, hwnd))) return RB_ENTRY_VALUE(entry, struct renku_win_data, entry);
+    pthread_mutex_unlock(&win_data_mutex);
+    return NULL;
+}
+
+static void release_win_data(struct renku_win_data *data)
+{
+    assert(data);
+    pthread_mutex_unlock(&win_data_mutex);
+}
+
+static BOOL is_toplevel(HWND hwnd)
+{
+    HWND parent = NtUserGetAncestor(hwnd, GA_PARENT);
+    return parent && parent == NtUserGetDesktopWindow();
+}
+
+/* A window with a caption gets the system decorator, which then draws the caption and the
+ * frame in place of Wine's (see GetWindowStyleMasks). Everything else, popups and menus
+ * included, is borderless and drawn entirely by Wine. */
+static enum be_window_style style_for(UINT style)
+{
+    return (style & WS_CAPTION) == WS_CAPTION ? BE_WINDOW_TITLED : BE_WINDOW_BORDERLESS;
+}
+
+static struct be_rect be_rect_from(const RECT *r)
+{
+    struct be_rect rect = { r->left, r->top, r->right, r->bottom };
+    return rect;
+}
+
+static char *get_window_title(HWND hwnd)
+{
+    WCHAR text[1024];
+
+    if (!NtUserInternalGetWindowText(hwnd, text, ARRAY_SIZE(text))) text[0] = 0;
+    return renku_utf8_from_wstr(text);
+}
+
+/***********************************************************************
+ *      WindowPosChanging (RENKU.@)
+ *
+ * Creates the BWindow the first time a top-level window is shown. It starts hidden;
+ * WindowPosChanged gives it its frame and shows it.
+ */
+BOOL RENKU_WindowPosChanging(HWND hwnd, UINT swp_flags, BOOL shaped, const struct window_rects *rects)
+{
+    struct renku_win_data *data, *created;
+    enum be_window_style style;
+    struct be_rect frame;
+    UINT win_style;
+    char *title;
+
+    TRACE("hwnd %p, swp_flags %04x, shaped %u, rects %s\n", hwnd, swp_flags, shaped, debugstr_window_rects(rects));
+
+    if ((data = get_win_data(hwnd)))
+    {
+        release_win_data(data);
+        return TRUE;
+    }
+    if (!is_toplevel(hwnd)) return FALSE;  /* no surface of its own */
+
+    /* Many top-level windows are never shown (IME, DDE and OLE helpers, explorer's own), and
+     * win32u gives a hidden window no surface anyway (get_window_surface), so the BWindow
+     * waits until the window is visible or being shown. */
+    win_style = NtUserGetWindowLongW(hwnd, GWL_STYLE);
+    if (!(win_style & WS_VISIBLE) && !(swp_flags & SWP_SHOWWINDOW)) return FALSE;
+
+    style = style_for(win_style);
+    title = get_window_title(hwnd);
+    /* rects->visible is not final yet; WindowPosChanged sets the real frame. */
+    frame = be_rect_from(&rects->window);
+
+    if (!(created = calloc(1, sizeof(*created))))
+    {
+        free(title);
+        return FALSE;
+    }
+    created->hwnd = hwnd;
+    created->style = style;
+    created->frame = frame;
+    if (!(created->window = be_window_create(style, &frame, title)))
+    {
+        ERR("no BWindow for %p\n", hwnd);
+        free(created);
+        free(title);
+        return FALSE;
+    }
+    free(title);
+
+    pthread_mutex_lock(&win_data_mutex);
+    if (rb_get(&win_data_tree, hwnd))
+    {
+        /* Another thread got there first. */
+        pthread_mutex_unlock(&win_data_mutex);
+        be_window_release(created->window);
+        free(created);
+        return TRUE;
+    }
+    rb_put(&win_data_tree, hwnd, &created->entry);
+    pthread_mutex_unlock(&win_data_mutex);
+
+    TRACE("hwnd %p: BWindow %p, %s\n", hwnd, created->window, style == BE_WINDOW_TITLED ? "titled" : "borderless");
+    return TRUE;
+}
+
+/***********************************************************************
+ *      GetWindowStyleMasks (RENKU.@)
+ *
+ * The window styles whose non-client parts the system decorator draws. win32u leaves them
+ * out of the window's visible rect (get_visible_rect, dlls/win32u/window.c), so the surface
+ * and the BWindow's frame cover only what Wine draws: the client area, plus the menu bar and
+ * any client edge.
+ */
+BOOL RENKU_GetWindowStyleMasks(HWND hwnd, UINT style, UINT ex_style, UINT *style_mask, UINT *ex_style_mask)
+{
+    *style_mask = *ex_style_mask = 0;
+    if (style_for(style) == BE_WINDOW_TITLED)
+    {
+        *style_mask = WS_CAPTION | WS_THICKFRAME;
+        *ex_style_mask = WS_EX_TOOLWINDOW | WS_EX_DLGMODALFRAME | WS_EX_WINDOWEDGE;
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *      CreateWindowSurface (RENKU.@)
+ */
+BOOL RENKU_CreateWindowSurface(HWND hwnd, BOOL layered, const RECT *surface_rect, struct window_surface **surface)
+{
+    struct window_surface *previous;
+    struct renku_win_data *data;
+    struct be_window *window;
+
+    TRACE("hwnd %p, layered %u, surface_rect %s, surface %p\n", hwnd, layered, wine_dbgstr_rect(surface_rect), surface);
+
+    /* win32u reuses a driver surface only if its rect still matches (dlls/win32u/dce.c). */
+    if ((previous = *surface) && renku_surface_bitmap(previous)) return TRUE;
+    if (!(data = get_win_data(hwnd))) return FALSE;
+    window = data->window;
+    be_window_add_ref(window);
+    release_win_data(data);
+
+    if (previous) window_surface_release(previous);
+    /* Not yet done: layered windows; they get an opaque surface for now. */
+    *surface = renku_surface_create(hwnd, window, surface_rect);
+    be_window_release(window);
+    return TRUE;
+}
+
+/***********************************************************************
+ *      WindowPosChanged (RENKU.@)
+ */
+void RENKU_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UINT swp_flags,
+                            const struct window_rects *new_rects, struct window_surface *surface)
+{
+    UINT style = NtUserGetWindowLongW(hwnd, GWL_STYLE);
+    struct be_rect frame = be_rect_from(&new_rects->visible);
+    struct renku_win_data *data;
+    struct window_surface *old_surface = NULL;
+    enum be_window_style be_style = style_for(style);
+    struct be_bitmap *bitmap = renku_surface_bitmap(surface);
+    /* Minimizing comes with the decorator's input; until then a minimized window is hidden. */
+    BOOL visible = (style & WS_VISIBLE) && !(style & WS_MINIMIZE) && !(swp_flags & SWP_HIDEWINDOW);
+
+    TRACE("hwnd %p new_rects %s after %p flags %08x surface %p\n", hwnd, debugstr_window_rects(new_rects),
+          insert_after, swp_flags, surface);
+
+    if (!(data = get_win_data(hwnd))) return;
+
+    if (be_style != data->style)
+    {
+        be_window_set_style(data->window, be_style);
+        data->style = be_style;
+    }
+    if (memcmp(&frame, &data->frame, sizeof(frame)))
+    {
+        be_window_set_frame(data->window, &frame);
+        data->frame = frame;
+    }
+    if (!bitmap) surface = NULL;  /* win32u's dummy surface, or none */
+    if (surface != data->surface)
+    {
+        /* surface->rect places the surface in the visible rect, which is the BWindow's frame. */
+        be_window_set_bitmap(data->window, bitmap, surface ? surface->rect.left : 0,
+                             surface ? surface->rect.top : 0);
+        if (surface) window_surface_add_ref(surface);
+        old_surface = data->surface;
+        data->surface = surface;
+    }
+    if (visible != data->visible)
+    {
+        be_window_set_visible(data->window, visible);
+        data->visible = visible;
+    }
+
+    release_win_data(data);
+    if (old_surface) window_surface_release(old_surface);
+}
+
+/***********************************************************************
+ *      SetWindowText (RENKU.@)
+ */
+void RENKU_SetWindowText(HWND hwnd, LPCWSTR text)
+{
+    struct renku_win_data *data;
+    char *title = renku_utf8_from_wstr(text);
+
+    if ((data = get_win_data(hwnd)))
+    {
+        be_window_set_title(data->window, title);
+        release_win_data(data);
+    }
+    free(title);
+}
+
+/***********************************************************************
+ *      DestroyWindow (RENKU.@)
+ */
+void RENKU_DestroyWindow(HWND hwnd)
+{
+    struct renku_win_data *data;
+
+    TRACE("%p\n", hwnd);
+
+    if (!(data = get_win_data(hwnd))) return;
+    rb_remove(&win_data_tree, &data->entry);
+    release_win_data(data);
+
+    /* The surface holds its own reference to the window handle. */
+    if (data->surface) window_surface_release(data->surface);
+    be_window_release(data->window);
+    free(data);
+}
-- 
2.47.3


From 6dd54783ce88ee15f047b28046857ce84c716ec1 Mon Sep 17 00:00:00 2001
From: rations <ehqcar@proton.me>
Date: Wed, 11 Nov 2026 09:50:19 +1000
Subject: [PATCH 16/20] explorer: Try the RenkuOS driver first.

explorer picks the graphics driver from default_driver when the prefix
sets none. Put "renku" (winerenku.drv) at its head.

explorer is PE code, built for a Windows target, so __HAIKU__ is not
defined there and cannot select the entry. It does not need to: where
a driver is not built, LoadLibrary fails with ERROR_MOD_NOT_FOUND and
the next name is tried, which is how "mac" is already skipped on every
other host. The RenkuOS port builds no other driver (--without-wayland
--without-x), so there winerenku.drv is the only one; the rest of the
list is upstream's, left as it is.
---
 programs/explorer/desktop.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/programs/explorer/desktop.c b/programs/explorer/desktop.c
index ce70c5dd..f0956929 100644
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -40,7 +40,10 @@ WINE_DEFAULT_DEBUG_CHANNEL(explorer);
 #define DESKTOP_CLASS_ATOM ((LPCWSTR)MAKEINTATOM(32769))
 #define DESKTOP_ALL_ACCESS 0x01ff
 
-static const WCHAR default_driver[] = L"mac,x11,wayland";
+/* renku (winerenku.drv, RenkuOS) is tried first. explorer is PE code, built for a Windows
+ * target, so __HAIKU__ cannot select it here; where the driver is not built, LoadLibrary
+ * fails with ERROR_MOD_NOT_FOUND and the next name is tried, as it is for mac today. */
+static const WCHAR default_driver[] = L"renku,mac,x11,wayland";
 
 static BOOL using_root = TRUE;
 
-- 
2.47.3


From 4f3044931be7eca83a33bfb0a8a97ed45d74670c Mon Sep 17 00:00:00 2001
From: rations <ehqcar@proton.me>
Date: Wed, 11 Nov 2026 11:21:19 +1000
Subject: [PATCH 17/20] winerenku.drv: Keyboard and mouse input, activation,
 and the decorator.

The first stage drew windows but took no input, and its windows could
not be moved, resized or closed. This adds both halves.

Input. Be loopers have no Wine thread data and cannot call win32u, so
they put what happened in a queue (be_event.cpp) and one Wine thread,
created by DllMain, takes it out and calls win32u (event.c), as
winewayland's event thread does. Neither side does more than copy an
event under the queue's mutex, so a looper never waits for Wine.

- Mouse: screen coordinates, as hardware input uses them (server/queue.c,
  queue_mouse_message). A button press sets B_POINTER_EVENTS so moves
  and the release keep coming outside the window, as SetCapture
  expects. Consecutive moves are merged in the queue, and the event
  thread flushes win32u's held-back motion (accum_mouse_motion in
  dlls/win32u/input.c) when no other event is waiting. Without that a
  drag reached the program only on release: no selection while dragging
  in notepad, no highlight under the pointer in menus.
- Wheel: one Haiku notch is one WHEEL_DELTA, sign flipped vertically.
- Keyboard: scancodes, which win32u maps through the layout's tables.
  The Haiku key code -> scancode table is generated from kATKeycodeMap
  (headers/private/input/ATKeymap.h), which both the PS/2 and virtio
  drivers use; USB HID produces the same codes. Pause is given its
  Windows code (E1 1D), as the PS/2 driver reports E0 46, which win32u
  reads as Ctrl+Break. Keys are taken in DispatchMessage, before
  BWindow's own shortcuts (Command+Q, Control+Tab, Print Screen,
  Command+Escape, Option+Tab), so programs get all of them. Haiku's
  repeats are passed on; wineserver's own repeat is off unless a driver
  turns it on.

Activation. app_server's activations become Wine's foreground window on
the window's own thread; a disabled window behind a modal dialog gives
way to that dialog, as on Windows. When focus goes to another program,
Wine's foreground goes to the desktop window, as in winex11's focus_out.
Wine's activations (ActivateWindow) activate the BWindow, except while
Wine is following app_server, so the two never undo each other. Menus,
tooltips and drop-downs (owned popups, and unowned tool-window popups,
which is how JUCE makes its menus) get B_AVOID_FOCUS: app_server brings
them forward without focusing them (Desktop::ActivateWindow). Before,
app_server activated a JUCE menu on Show() and JUCE closed it.

The decorator. Its buttons follow the window style: resize border for
WS_THICKFRAME, minimize and zoom for their boxes, close for WS_SYSMENU
without CS_NOCLOSE.
- Close, minimize, restore and zoom become WM_SYSCOMMAND, so the program
  decides, as with a Windows title bar. app_server leaves minimizing to
  the client (ServerWindow::NotifyMinimize), from the decorator and the
  Deskbar alike; Wine's decision is then applied with
  BWindow::Minimize, so a minimized window stays in the Deskbar.
- Moves and resizes: one event per batch; the window's thread asks the
  looper for the current frame, which reflects every frame Wine posted
  before, so a stale position cannot undo a newer one. The window rect
  is rebuilt from it with the last window_rects. Frames that came from
  the BWindow are not sent back to it, so a drag is not fought.

Two display fixes found with these:
- A new surface (each resize step makes one) is put in the view on its
  first flush, not at once: the view showed it blank, so the whole
  window flashed white on every resize step.
- Layered windows that let clicks through (WS_EX_LAYERED |
  WS_EX_TRANSPARENT) get no BWindow. RenkuOS has no translucent or shaped
  windows (probe P4), and JUCE's drop shadows, four such windows around
  each of its windows, showed as solid black edges. win32u gives them
  an offscreen surface instead. Lost with this: a click-through overlay
  meant to be seen.

Verified in the RenkuOS build VM (hrev60072+518) by the user: notepad
(typing, selecting by dragging, menus by mouse and Alt+F, the save
dialog, moving, resizing, zoom, minimize and restore from the Deskbar,
close) and ML Sound Lab's Amped - Roots, a JUCE 6.1.5 program (its own
title bar, knobs, menus, settings dialogs, resizing).

Not done yet: cursor shapes (the pointer is always the arrow), keyboard
layouts other than US (win32u's default tables are used), showing a
normal window without activating it (SWP_NOACTIVATE) unless it avoids
focus, WM_ENTERSIZEMOVE/WM_EXITSIZEMOVE around a decorator drag, a work
area that leaves out the Deskbar, and Deskbar "Quit", which is still
refused. Newly uncovered area is white until Wine paints it.
---
 dlls/winerenku.drv/Makefile.in   |   2 +
 dlls/winerenku.drv/be_event.cpp  |  83 +++++++++
 dlls/winerenku.drv/be_private.h  |   4 +
 dlls/winerenku.drv/be_window.cpp | 264 +++++++++++++++++++++++++--
 dlls/winerenku.drv/dllmain.c     |  19 +-
 dlls/winerenku.drv/event.c       | 301 +++++++++++++++++++++++++++++++
 dlls/winerenku.drv/renku.h       |  14 ++
 dlls/winerenku.drv/renku_be.h    |  74 +++++++-
 dlls/winerenku.drv/renku_main.c  |   9 +-
 dlls/winerenku.drv/surface.c     |  26 ++-
 dlls/winerenku.drv/unixlib.h     |   1 +
