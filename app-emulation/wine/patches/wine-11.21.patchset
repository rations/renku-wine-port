 /* One BWindow. The handle is reference counted and stays valid after the BWindow has gone:
  * every call on it then does nothing. */
@@ -107,6 +109,21 @@ void be_window_set_bitmap(struct be_window *window, struct be_bitmap *bitmap, in
 /* Redraw rect, in window coordinates. */
 void be_window_invalidate(struct be_window *window, const struct be_rect *rect);
 
+/* A layer: a view of its own in a window, above the window's bitmap, that shows one bitmap
+ * at a time. For OpenGL client surfaces: a frame is shown by app_server as soon as it is
+ * handed over, with no window surface flush in between. Created hidden; the first bitmap shows
+ * it. The handle stays valid after the window has gone: every call then does nothing. */
+struct be_layer;
+struct be_layer *be_layer_create(struct be_window *window);
+/* Where the layer is, in window coordinates. */
+void be_layer_set_frame(struct be_layer *layer, const struct be_rect *frame);
+/* Show bitmap, its top-left pixel at the layer's. The layer takes its own reference and drops
+ * it when the next bitmap comes, so be_bitmap_in_use() says when the caller may draw into it
+ * again. */
+void be_layer_set_bitmap(struct be_layer *layer, struct be_bitmap *bitmap);
+/* Removes the layer and frees the handle. */
+void be_layer_destroy(struct be_layer *layer);
+
 /* Events from the Be side, in the order they happened. */
 enum be_event_type
 {
