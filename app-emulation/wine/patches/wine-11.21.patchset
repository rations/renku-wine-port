+extern "C" int be_window_get_frame(struct be_window *window, struct be_rect *frame)
+{
+    BMessage msg(MSG_GET_FRAME), reply;
+    BRect rect;
+
+    if (!window || window->messenger.SendMessage(&msg, &reply, B_INFINITE_TIMEOUT, 1000000) != B_OK ||
+        reply.FindRect("frame", &rect) != B_OK)
