+          fCookie(cookie), fButtons(0)
     {
         /* app_server must not clear the update area first: Draw() covers it. */
         SetViewColor(B_TRANSPARENT_COLOR);
@@ -132,28 +156,164 @@ public:
         if (rest.CountRects()) FillRegion(&rest, B_SOLID_LOW);
     }
 
+    /* Mouse events go to Wine in screen coordinates: the BWindow's frame is the window's
+     * visible rect, so they need no other conversion. win32u finds the window under the
+     * pointer, and makes double clicks, itself. */
+    void MouseDown(BPoint where) override
+    {
+        /* Keeps the moves and the release coming while the button is held outside the
+         * window, as a Win32 program's SetCapture expects. app_server ends it on release. */
+        SetMouseEventMask(B_POINTER_EVENTS, B_NO_POINTER_HISTORY);
+        UpdateButtons(where);
+    }
+
+    void MouseUp(BPoint where) override
+    {
+        UpdateButtons(where);
+    }
+
+    void MouseMoved(BPoint where, uint32 transit, const BMessage *drag) override
+    {
+        struct be_event event = {};
+        BPoint screen = ConvertToScreen(where);
+
+        event.x = (int32)floorf(screen.x);
+        event.y = (int32)floorf(screen.y);
+        post_event(BE_EVENT_MOUSE_MOVE, fCookie, &event);
+    }
+
+    void MessageReceived(BMessage *msg) override
+    {
+        if (msg->what == B_MOUSE_WHEEL_CHANGED)
+        {
+            struct be_event event = {};
+            event.wheel_x = msg->GetFloat("be:wheel_delta_x", 0);
+            event.wheel_y = msg->GetFloat("be:wheel_delta_y", 0);
+            post_event(BE_EVENT_MOUSE_WHEEL, fCookie, &event);
+            return;
+        }
+        BView::MessageReceived(msg);
+    }
+
 private:
+    /* B_MOUSE_DOWN and B_MOUSE_UP carry the buttons held after the change. */
+    void UpdateButtons(BPoint where)
+    {
+        BMessage *msg = Window()->CurrentMessage();
+        uint32 buttons = msg ? (uint32)msg->GetInt32("buttons", 0) : 0;
+        uint32 changed = buttons ^ fButtons;
+        BPoint screen = ConvertToScreen(where);
+
+        for (size_t i = 0; i < sizeof(kButtons) / sizeof(kButtons[0]); i++)
+        {
+            struct be_event event = {};
+            if (!(changed & kButtons[i])) continue;
+            event.x = (int32)floorf(screen.x);
+            event.y = (int32)floorf(screen.y);
+            event.button = (int32)i;
+            event.down = (buttons & kButtons[i]) != 0;
+            post_event(BE_EVENT_MOUSE_BUTTON, fCookie, &event);
+        }
+        fButtons = buttons;
+    }
+
     struct be_bitmap *fBitmap;
     BPoint fOrigin;
+    uint64 fCookie;
+    uint32 fButtons;
 };
 
