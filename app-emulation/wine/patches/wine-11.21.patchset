From f752c55a97c4658e69844f78d051be157415eb10 Mon Sep 17 00:00:00 2001
From: rations <ehqcar@proton.me>
Date: Sun, 19 Jul 2026 22:04:22 +1000
Subject: [PATCH 03/20] Run static initializers in Winelib modules on Haiku

Haikus libroot has neither dladdr1() nor dlinfo(), so __wine_init_so_dll()
compiled to an empty function and no static constructor in any Winelib module
was ever run. C++ modules then faulted on first use of a statically
initialized object, before main() produced any output.

winebuild renames DT_INIT_ARRAY and friends to private tags so the system
loader will not run them and Wine can run them itself once the PE environment
exists, so nothing else covered for this.

Locate the current module with get_next_image_info() and walk its dynamic
section from the program headers, which runtime_loader maps at the start of
the text segment.
---
 libs/winecrt0/dll_soinit.c | 75 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 75 insertions(+)

diff --git a/libs/winecrt0/dll_soinit.c b/libs/winecrt0/dll_soinit.c
index 88d00d1f..f4ab87b1 100644
--- a/libs/winecrt0/dll_soinit.c
+++ b/libs/winecrt0/dll_soinit.c
@@ -46,6 +46,9 @@
 #ifdef HAVE_LINK_H
 # include <link.h>
 #endif
+#ifdef __HAIKU__
+# include <kernel/image.h>
+#endif
 #include "windef.h"
 
 
@@ -126,5 +129,77 @@ void __wine_init_so_dll(void)
     if (init_array)
         for (i = 0; i < init_arraysz / sizeof(*init_array); i++)
             init_array[i]( 0, NULL, NULL );
+
+#elif defined(__HAIKU__)
+
+    /* Haiku's libroot has neither `dladdr1()` nor `dlinfo()`, so without this
+     * branch the function above is empty and no static constructor in a Winelib
+     * module ever runs -- C++ modules then fault on the first use of any
+     * statically initialized object.  Nothing else picks up the slack, because
+     * winebuild deliberately renames `DT_INIT_ARRAY` and friends to the private
+     * tags below so that the system loader leaves them alone and Wine can run
+     * them itself once the PE environment is ready.
+     *
+     * `get_next_image_info()` enumerates the loaded images; the one whose text
+     * segment contains this function is the module to initialize.  Haiku's
+     * runtime_loader maps the ELF header at the start of that text segment,
+     * which is what lets us reach the program headers from there -- the same
+     * assumption Haiku's own `dl_iterate_phdr()` implementation makes.
+     */
+    image_info info;
+    int32 cookie = 0;
+    void (*init_func)(int, char **, char **) = NULL;
+    void (**init_array)(int, char **, char **) = NULL;
+    long i, init_arraysz = 0;
+#ifdef _WIN64
+    const Elf64_Ehdr *ehdr;
+    const Elf64_Phdr *phdr;
+    const Elf64_Dyn *dyn = NULL;
+#else
+    const Elf32_Ehdr *ehdr;
+    const Elf32_Phdr *phdr;
+    const Elf32_Dyn *dyn = NULL;
+#endif
+
+    while (get_next_image_info( 0, &cookie, &info ) == B_OK)
+    {
+        const char *base = (const char *)info.text;
+        const char *self = (const char *)(void *)__wine_init_so_dll;
+        unsigned int j;
+
+        if (self < base || self >= base + info.text_size) continue;
+
+        /* Guard against images whose header is not mapped, and against the
+         * commpage, which is not an ELF image at all. */
+        ehdr = (void *)base;
+        if (ehdr->e_ident[0] != 0x7f || ehdr->e_ident[1] != 'E' ||
+            ehdr->e_ident[2] != 'L'  || ehdr->e_ident[3] != 'F') return;
+
+        phdr = (void *)(base + ehdr->e_phoff);
+        for (j = 0; j < ehdr->e_phnum; j++)
+        {
+            if (phdr[j].p_type != PT_DYNAMIC) continue;
+            dyn = (void *)(base + phdr[j].p_vaddr);
+            break;
+        }
+        if (!dyn) return;
+
+        for ( ; dyn->d_tag; dyn++)
+        {
+            switch (dyn->d_tag)
+            {
+            case 0x60009994: init_array = (void *)(base + dyn->d_un.d_val); break;
+            case 0x60009995: init_arraysz = dyn->d_un.d_val; break;
+            case 0x60009996: init_func = (void *)(base + dyn->d_un.d_val); break;
+            }
+        }
+
+        if (init_func) init_func( 0, NULL, NULL );
+
+        if (init_array)
+            for (i = 0; i < init_arraysz / sizeof(*init_array); i++)
+                init_array[i]( 0, NULL, NULL );
+        return;
+    }
 #endif
 }
-- 
2.47.3


From a3b838bf3f16d70b4edd51c837d73f370bffc53b Mon Sep 17 00:00:00 2001
From: rations <ehqcar@proton.me>
Date: Mon, 20 Jul 2026 00:23:17 +1000
Subject: [PATCH 04/20] Do not block in the SIGSEGV handler on Haiku

The Haiku port left an interactive debug hook in segv_handler: after
printing the fault it called fgetc(stdin) and waited for a keypress, with
the _exit(1) below it commented out.

Any process without a usable stdin -- a DAW, a GUI application, anything
launched from the Deskbar -- therefore hangs instead of crashing.  Worse,
when stdin is at EOF the read returns immediately, the handler falls
through, the faulting instruction re-executes and faults again, spinning
a core indefinitely.  Every crash became an unkillable freeze that hid
the actual fault, and left orphaned wine sessions behind because the
faulting process never exited.

Keep the diagnostics, drop the wait, and let execution continue into the
normal exception dispatch as upstream does.
---
 dlls/ntdll/unix/signal_x86_64.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 50a7990f..51159fcb 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2342,7 +2342,14 @@ static void segv_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
     printf("  FP: %#" PRIx64 "\n", RBP_sig(sigcontext));
     printf("  address: %#" PRIx64 "\n", siginfo->si_addr);
     WriteModuleName(RIP_sig(sigcontext));
-    fgetc(stdin);
+    /* The Haiku port stopped here with a blocking fgetc(stdin) so a developer
+     * could inspect the fault interactively.  Anything without a usable stdin
+     * -- a DAW, any GUI app, anything started from the Deskbar -- then turns
+     * every SIGSEGV into a hang instead of a crash: the handler either blocks
+     * forever, or gets EOF straight back, falls through, re-executes the
+     * faulting instruction and faults again in a tight loop, pinning a core.
+     * The diagnostics above are kept; execution now continues into the normal
+     * exception dispatch below, which is what upstream does. */
     //_exit(1);
 #endif
 
-- 
2.47.3


From 12875a433f93fba5550295b642cb07217c3a1062 Mon Sep 17 00:00:00 2001
From: rations <ehqcar@proton.me>
Date: Mon, 20 Jul 2026 17:47:27 +1000
Subject: [PATCH 05/20] loader: find the loader path via find_path() on Haiku

Haiku has no /proc, so get_self_exe() returned NULL and the loader fell
back to resolving argv[0]. That works for any invocation carrying a
slash, but a bare "wine" picked up from PATH was resolved relative to
the current directory and failed with "could not load ntdll.so".

find_path() with B_FIND_PATH_IMAGE_PATH maps a pointer back to the image
containing it, which for a pointer into the loader gives the loader path.
---
 loader/main.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/loader/main.c b/loader/main.c
index 71ba308c..e959a762 100644
--- a/loader/main.c
+++ b/loader/main.c
@@ -37,6 +37,9 @@
 #ifdef __APPLE__
 # include <mach-o/dyld.h>
 #endif
+#ifdef __HAIKU__
+# include <FindDirectory.h>
+#endif
 
 #include "main.h"
 
@@ -139,6 +142,14 @@ static const char *get_self_exe(void)
     if (path && !_NSGetExecutablePath( path, &path_size ))
         return path;
     free( path );
+#elif defined(__HAIKU__)
+    /* Haiku has no /proc; find_path() maps a pointer back to the image
+     * containing it, which for a pointer into the loader is the loader. */
+    char *path = malloc( PATH_MAX );
+    if (path && find_path( (const void *)get_self_exe, B_FIND_PATH_IMAGE_PATH,
+                           NULL, path, PATH_MAX ) == B_OK)
+        return path;
+    free( path );
 #endif
     return NULL;
 }
-- 
2.47.3


From 2b7a3ec7aa20c930466252db0dac5678fd8a178f Mon Sep 17 00:00:00 2001
From: rations <ehqcar@proton.me>
Date: Mon, 27 Jul 2026 01:36:07 +1000
Subject: [PATCH 06/20] dxgi: Wait for a refresh interval in
 IDXGIOutput::WaitForVBlank().

WaitForVBlank() printed a FIXME and returned E_NOTIMPL immediately,
without waiting for anything.

Applications that pace a rendering thread on it therefore spin: JUCE 8's
Direct2D renderer runs a dedicated thread that calls WaitForVBlank() in a
loop and drives all of its repainting from the result. With the stub that
loop never throttles to the refresh rate. Measured on a Nembrini Audio
VST3 plug-in editor under a software OpenGL adapter, it made 62,024 calls
in about 25 seconds and saturated a CPU core, and the plug-in's editor
painted a single frame and then never updated or responded to input again
- although win32u was delivering every mouse message to its window
correctly.

There is no vertical blank signal available to wait on, so sleep to the
next refresh interval boundary derived from the output's current display
mode instead. That is what callers of this function actually need: a
cadence to render at. Phase-locking to a monotonic tick rather than
sleeping a fixed amount keeps the cadence stable no matter how long the
caller spent rendering between calls.

Not conditional on any platform - the stub behaves the same everywhere,
which matches reports of the same plug-ins being uninteractive under Wine
on Linux until DXVK, whose own DXGI implementation does wait, is
installed.
---
 dlls/dxgi/output.c | 32 ++++++++++++++++++++++++++------
 1 file changed, 26 insertions(+), 6 deletions(-)

diff --git a/dlls/dxgi/output.c b/dlls/dxgi/output.c
index e828ed0d..9690dee6 100644
--- a/dlls/dxgi/output.c
+++ b/dlls/dxgi/output.c
@@ -363,14 +363,34 @@ static HRESULT STDMETHODCALLTYPE dxgi_output_FindClosestMatchingMode(IDXGIOutput
 
 static HRESULT STDMETHODCALLTYPE dxgi_output_WaitForVBlank(IDXGIOutput6 *iface)
 {
-    static BOOL once = FALSE;
+    struct dxgi_output *output = impl_from_IDXGIOutput6(iface);
+    enum wined3d_display_rotation rotation;
+    struct wined3d_display_mode mode;
+    unsigned int refresh_rate, interval;
+    HRESULT hr;
 
-    if (!once++)
-        FIXME("iface %p stub!\n", iface);
-    else
-        TRACE("iface %p stub!\n", iface);
+    TRACE("iface %p.\n", iface);
 
-    return E_NOTIMPL;
+    wined3d_mutex_lock();
+    hr = wined3d_output_get_display_mode(output->wined3d_output, &mode, &rotation);
+    wined3d_mutex_unlock();
+    if (FAILED(hr))
+    {
+        WARN("Failed to get output display mode, hr %#lx.\n", hr);
+        return hr;
+    }
+
+    /* There is no vertical blank to wait on, so approximate one by sleeping to
+     * the next refresh interval boundary. Callers use this to pace a rendering
+     * thread, so returning without waiting turns that thread into a busy loop. */
+    if (!(refresh_rate = mode.refresh_rate))
+        refresh_rate = 60;
+    if (!(interval = 1000 / refresh_rate))
+        interval = 1;
+
+    Sleep(interval - (unsigned int)(GetTickCount64() % interval));
+
+    return S_OK;
 }
 
 static HRESULT STDMETHODCALLTYPE dxgi_output_TakeOwnership(IDXGIOutput6 *iface, IUnknown *device, BOOL exclusive)
-- 
2.47.3


From 0a42024077120607d053971cf91931db729544c4 Mon Sep 17 00:00:00 2001
From: rations <ehqcar@proton.me>
Date: Wed, 7 Oct 2026 12:34:24 +1000
Subject: [PATCH 07/20] sechost: Report no failure actions in
 QueryServiceConfig2W.

services.exe doesn't keep a service's failure actions: ChangeServiceConfig2W accepts them with a
FIXME, but QueryServiceConfig2W failed with ERROR_INVALID_LEVEL. WiX's ServiceConfig custom action
(Wix4ServiceConfig, used by iLok's PACE License Support installer) reads the current failure
actions before it sets them, for its rollback, and fails the whole install when that query fails.

For SERVICE_CONFIG_FAILURE_ACTIONS and SERVICE_CONFIG_FAILURE_ACTIONS_FLAG, report what a
service without failure actions reports on Windows: the structure, zeroed. The handle is checked
with a SERVICE_CONFIG_PRESHUTDOWN_INFO query first, so an invalid handle or missing
SERVICE_QUERY_CONFIG access still fails as before.
---
 dlls/sechost/service.c | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/dlls/sechost/service.c b/dlls/sechost/service.c
index f05fd2d7..20a7fb17 100644
--- a/dlls/sechost/service.c
+++ b/dlls/sechost/service.c
@@ -844,6 +844,37 @@ BOOL WINAPI DECLSPEC_HOTPATCH QueryServiceConfig2W( SC_HANDLE service, DWORD lev
         bufptr = buffer;
         break;
 
+    /* services.exe doesn't keep failure actions (ChangeServiceConfig2W takes them with a FIXME),
+     * so a service has none: no reset period, command, reboot message or actions, and the flag is
+     * off. Installers made with WiX's ServiceConfig (iLok's, for one) read them before setting
+     * them, and fail the install when the query fails. The service handle is still checked, by
+     * a query services.exe does answer. */
+    case SERVICE_CONFIG_FAILURE_ACTIONS:
+    case SERVICE_CONFIG_FAILURE_ACTIONS_FLAG:
+    {
+        DWORD needed = level == SERVICE_CONFIG_FAILURE_ACTIONS ? sizeof(SERVICE_FAILURE_ACTIONSW)
+                                                               : sizeof(SERVICE_FAILURE_ACTIONS_FLAG);
+        SERVICE_PRESHUTDOWN_INFO preshutdown;
+        DWORD preshutdown_size;
+
+        if (!QueryServiceConfig2W( service, SERVICE_CONFIG_PRESHUTDOWN_INFO, (BYTE *)&preshutdown,
+                                   sizeof(preshutdown), &preshutdown_size ))
+            return FALSE;
+        if (!ret_size)
+        {
+            SetLastError( ERROR_INVALID_ADDRESS );
+            return FALSE;
+        }
+        *ret_size = needed;
+        if (size < needed)
+        {
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            return FALSE;
+        }
+        memset( buffer, 0, needed );
+        return TRUE;
+    }
+
     default:
         FIXME("Level %ld not implemented\n", level);
         SetLastError(ERROR_INVALID_LEVEL);
-- 
2.47.3


From ecedb5097c56f6a95c790a1a27eeb0910bb987db Mon Sep 17 00:00:00 2001
From: rations <ehqcar@proton.me>
Date: Wed, 7 Oct 2026 12:34:45 +1000
Subject: [PATCH 08/20] msiexec, rundll32: Declare Windows 10 compatibility in
 their manifests.

Windows 8.1 and later report Windows 8 (6.2) to a program whose manifest doesn't list the newer
versions under supportedOS, and Wine does the same (init_current_version in kernelbase). The
program here is the process an MSI custom action runs in: Wine's msiexec.exe (the custom action
server), or rundll32.exe for WiX's managed (.NET) custom actions, which run out of process. Wine's
manifests have no compatibility section, so custom actions saw Windows 8 in a Windows 10 prefix.
Windows' own msiexec.exe and rundll32.exe list every version up to Windows 10.

iLok's PACE License Support installer checks for Windows 10 in such a custom action
(SetCompatibleOSVersion) and refuses to install otherwise. Add the same supportedOS list to
msiexec.manifest, and give rundll32.exe a manifest with it.
---
 programs/msiexec/msiexec.manifest   | 10 ++++++++++
 programs/rundll32/Makefile.in       |  1 +
 programs/rundll32/rsrc.rc           | 25 +++++++++++++++++++++++++
 programs/rundll32/rundll32.manifest | 14 ++++++++++++++
 4 files changed, 50 insertions(+)
 create mode 100644 programs/rundll32/rsrc.rc
 create mode 100644 programs/rundll32/rundll32.manifest

diff --git a/programs/msiexec/msiexec.manifest b/programs/msiexec/msiexec.manifest
index 0e345455..85d1502e 100644
--- a/programs/msiexec/msiexec.manifest
+++ b/programs/msiexec/msiexec.manifest
@@ -13,6 +13,16 @@
         />
     </dependentAssembly>
 </dependency>
+<compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
+    <application>
+        <!-- Windows Vista, 7, 8, 8.1 and 10 -->
+        <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
+        <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
+        <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
+        <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
+        <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
+    </application>
+</compatibility>
 <application xmlns="urn:schemas-microsoft-com:asm.v3">
     <windowsSettings>
         <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
diff --git a/programs/rundll32/Makefile.in b/programs/rundll32/Makefile.in
index 7cb55688..3fb46da0 100644
--- a/programs/rundll32/Makefile.in
+++ b/programs/rundll32/Makefile.in
@@ -5,4 +5,5 @@ ENABLE_ARCHS = $(PE_ARCHS)
 EXTRADLLFLAGS = -mwindows -municode
 
 SOURCES = \
+	rsrc.rc \
 	rundll32.c
diff --git a/programs/rundll32/rsrc.rc b/programs/rundll32/rsrc.rc
new file mode 100644
index 00000000..7607583b
--- /dev/null
+++ b/programs/rundll32/rsrc.rc
@@ -0,0 +1,25 @@
+/*
+ * Copyright (c) 2026 rations
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
