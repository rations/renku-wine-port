+dnl **** Check for the Be API (RenkuOS native driver) ****
+case $host_os in
+  haiku*)
+    if test "x$with_renku" != "xno"
+    then
+        AC_LANG_PUSH([C++])
+        AC_CHECK_HEADER([Application.h],[AC_SUBST(RENKU_LIBS,["-lbe -lstdc++"])])
+        AC_LANG_POP([C++])
+    fi
+    WINE_ERROR_WITH(renku,[test -z "$RENKU_LIBS"],
+                    [Be API development files (Application.h) not found, the RenkuOS driver won't be supported.],
+                    [enable_winerenku_drv])
+    ;;
