-/* Until Wine hears about it, a window the user moves, resizes, closes, zooms or minimizes
- * with the decorator would no longer be where Wine thinks it is. Those events reach Wine with
- * the input work (FrameMoved, FrameResized, QuitRequested -> SC_CLOSE, ...); until then the
- * decorator offers none of them. */
-const uint32 kFixedWindowFlags = B_NOT_MOVABLE | B_NOT_RESIZABLE | B_NOT_CLOSABLE |
-                                 B_NOT_ZOOMABLE | B_NOT_MINIMIZABLE;
+uint32 flags_for(unsigned int flags)
+{
+    uint32 be_flags = 0;
+
+    if (flags & BE_WINDOW_AVOID_FOCUS) be_flags |= B_AVOID_FOCUS;
+    if (!(flags & BE_WINDOW_RESIZABLE)) be_flags |= B_NOT_RESIZABLE;
+    if (!(flags & BE_WINDOW_MINIMIZABLE)) be_flags |= B_NOT_MINIMIZABLE;
+    if (!(flags & BE_WINDOW_ZOOMABLE)) be_flags |= B_NOT_ZOOMABLE;
+    if (!(flags & BE_WINDOW_CLOSABLE)) be_flags |= B_NOT_CLOSABLE;
+    return be_flags;
+}
+
+void post_event(enum be_event_type type, uint64 cookie, struct be_event *event)
+{
+    event->type = type;
+    event->cookie = cookie;
+    be_event_post(event);
+}
+
+/* Haiku's buttons, B_MOUSE_BUTTON(1) to (5) (View.h), after the input server's remapping
+ * (left-handed mice included). */
+const uint32 kButtons[] = { B_PRIMARY_MOUSE_BUTTON, B_SECONDARY_MOUSE_BUTTON,
+                            B_TERTIARY_MOUSE_BUTTON, B_MOUSE_BUTTON(4), B_MOUSE_BUTTON(5) };
 
