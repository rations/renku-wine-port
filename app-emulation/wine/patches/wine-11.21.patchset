diff --git a/dlls/winerenku.drv/be_event.cpp b/dlls/winerenku.drv/be_event.cpp
new file mode 100644
index 00000000..17bbb62a
--- /dev/null
+++ b/dlls/winerenku.drv/be_event.cpp
@@ -0,0 +1,83 @@
+/*
+ * RenkuOS driver: the queue of events from Be threads to Wine
+ *
+ * Copyright 2026 rations
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "be_private.h"
+
+#include <SupportDefs.h>
+
+#include <deque>
+#include <pthread.h>
+
+/* Be threads (window loopers) cannot call Wine: they have no Wine thread data. They queue
+ * what happened here, and one Wine thread, the driver's event thread, takes it out and calls
+ * win32u (event.c). Neither side does anything but copy an event while holding the mutex, so
+ * a looper never waits for more than that copy. */
+
+namespace {
+
+pthread_mutex_t queue_mutex = PTHREAD_MUTEX_INITIALIZER;
+pthread_cond_t queue_cond = PTHREAD_COND_INITIALIZER;
+std::deque<struct be_event> queue;
+
+int32 active_windows;
+
+}  /* namespace */
+
+void be_event_post(const struct be_event *event)
+{
+    pthread_mutex_lock(&queue_mutex);
+    /* Only the latest position matters; merging moves keeps a busy pointer from piling up. */
+    if (event->type == BE_EVENT_MOUSE_MOVE && !queue.empty() &&
+        queue.back().type == BE_EVENT_MOUSE_MOVE && queue.back().cookie == event->cookie)
+        queue.back() = *event;
+    else
+        queue.push_back(*event);
+    if (event->type == BE_EVENT_ACTIVATE) atomic_add(&active_windows, event->down ? 1 : -1);
+    pthread_cond_signal(&queue_cond);
+    pthread_mutex_unlock(&queue_mutex);
+}
+
+extern "C" void be_event_wait(struct be_event *event)
+{
+    pthread_mutex_lock(&queue_mutex);
+    while (queue.empty()) pthread_cond_wait(&queue_cond, &queue_mutex);
+    *event = queue.front();
+    queue.pop_front();
+    pthread_mutex_unlock(&queue_mutex);
+}
+
+extern "C" int be_event_pending(void)
+{
+    int pending;
+
+    pthread_mutex_lock(&queue_mutex);
+    pending = !queue.empty();
+    pthread_mutex_unlock(&queue_mutex);
+    return pending;
+}
+
+extern "C" int be_any_window_active(void)
+{
+    return atomic_get(&active_windows) > 0;
+}
