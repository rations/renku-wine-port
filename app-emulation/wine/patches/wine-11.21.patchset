diff --git a/dlls/winerenku.drv/dllmain.c b/dlls/winerenku.drv/dllmain.c
index 917622b3..768e2fad 100644
--- a/dlls/winerenku.drv/dllmain.c
+++ b/dlls/winerenku.drv/dllmain.c
@@ -24,8 +24,19 @@
 #include "winbase.h"
 #include "unixlib.h"
 
+/* Passes the Be side's events (input, activation, close requests) to win32u. It has to be a
+ * Wine thread to call win32u, so it is created here and runs the unix side's loop, which
+ * does not return. */
+static DWORD WINAPI event_thread(void *arg)
+{
+    WINE_UNIX_CALL(renku_unix_func_event_loop, NULL);
+    return 0;
+}
+
 BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
 {
+    HANDLE thread;
+
     if (reason != DLL_PROCESS_ATTACH) return TRUE;
 
     DisableThreadLibraryCalls(instance);
@@ -33,5 +44,11 @@ BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
 
     /* Registers the driver with win32u. It does not contact app_server: the BApplication is
      * started by the first thing that needs it (a window, a bitmap or a screen query). */
-    return !WINE_UNIX_CALL(renku_unix_func_init, NULL);
+    if (WINE_UNIX_CALL(renku_unix_func_init, NULL)) return FALSE;
+
+    /* The thread starts running once the loader lock is released. */
+    if (!(thread = CreateThread(NULL, 0, event_thread, NULL, 0, NULL))) return FALSE;
+    SetThreadDescription(thread, L"wine_renku_events");
+    CloseHandle(thread);
+    return TRUE;
 }
diff --git a/dlls/winerenku.drv/event.c b/dlls/winerenku.drv/event.c
new file mode 100644
index 00000000..97169bfa
--- /dev/null
+++ b/dlls/winerenku.drv/event.c
@@ -0,0 +1,301 @@
+/*
+ * RenkuOS driver: events from the Be side, on the driver's event thread
+ *
+ * Copyright 2026 rations
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <math.h>
+
+#include "renku.h"
+#include "wine/server.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(renkudrv);
+WINE_DECLARE_DEBUG_CHANNEL(key);
+
+/* Haiku raw key code -> PC scancode, in the encoding win32u's keyboard tables use: 0x0nn is
+ * a plain set 1 scancode, 0x1nn has the E0 prefix (KEYEVENTF_EXTENDEDKEY), 0x2nn the E1
+ * prefix (only Pause). Haiku numbers keys by position, and both its PS/2 driver
+ * (src/add-ons/kernel/bus_managers/ps2/ps2_keyboard.cpp) and its virtio input device get the
+ * code from kATKeycodeMap (headers/private/input/ATKeymap.h), indexed by set 1 scancode - 1,
+ * with 0x80 added for an E0 key. This table is that one inverted, generated from it, not
+ * typed. One exception: the PS/2 driver reports Pause as E0 46, which win32u's tables read as
+ * Ctrl+Break (X46, VK_CANCEL), so Pause is given its Windows code, E1 1D (Y1D, VK_PAUSE).
+ * USB keyboards produce the same codes through their own table (kKeyTable in
+ * src/add-ons/kernel/drivers/input/hid_shared/KeyboardProtocolHandler.cpp; A is 0x3c in both). */
+static const WORD keycode_to_scan[0x80] =
+{
+    [0x01] = 0x001, /* Esc */
+    [0x02] = 0x03b, /* F1 */
+    [0x03] = 0x03c, /* F2 */
+    [0x04] = 0x03d, /* F3 */
+    [0x05] = 0x03e, /* F4 */
+    [0x06] = 0x03f, /* F5 */
+    [0x07] = 0x040, /* F6 */
+    [0x08] = 0x041, /* F7 */
+    [0x09] = 0x042, /* F8 */
+    [0x0a] = 0x043, /* F9 */
+    [0x0b] = 0x044, /* F10 */
+    [0x0c] = 0x057, /* F11 */
+    [0x0d] = 0x058, /* F12 */
+    [0x0e] = 0x137, /* Print Screen */
+    [0x0f] = 0x046, /* Scroll */
+    [0x10] = 0x21d, /* Pause (E1 1D, not the E0 46 the PS/2 driver reports) */
+    [0x11] = 0x029, /* ` */
+    [0x12] = 0x002, /* 1 */
+    [0x13] = 0x003, /* 2 */
+    [0x14] = 0x004, /* 3 */
+    [0x15] = 0x005, /* 4 */
+    [0x16] = 0x006, /* 5 */
+    [0x17] = 0x007, /* 6 */
+    [0x18] = 0x008, /* 7 */
+    [0x19] = 0x009, /* 8 */
+    [0x1a] = 0x00a, /* 9 */
+    [0x1b] = 0x00b, /* 0 */
+    [0x1c] = 0x00c, /* - */
+    [0x1d] = 0x00d, /* = */
+    [0x1e] = 0x00e, /* BACKSPACE */
+    [0x1f] = 0x152, /* Insert */
+    [0x20] = 0x147, /* Home */
+    [0x21] = 0x149, /* Page Up */
+    [0x22] = 0x045, /* Num */
+    [0x23] = 0x135, /* KP / */
+    [0x24] = 0x037, /* * */
+    [0x25] = 0x04a, /* KP - */
+    [0x26] = 0x00f, /* TAB */
+    [0x27] = 0x010, /* Q */
+    [0x28] = 0x011, /* W */
+    [0x29] = 0x012, /* E */
+    [0x2a] = 0x013, /* R */
+    [0x2b] = 0x014, /* T */
+    [0x2c] = 0x015, /* Y */
+    [0x2d] = 0x016, /* U */
+    [0x2e] = 0x017, /* I */
+    [0x2f] = 0x018, /* O */
+    [0x30] = 0x019, /* P */
+    [0x31] = 0x01a, /* [ */
+    [0x32] = 0x01b, /* ] */
+    [0x33] = 0x02b, /* backslash */
+    [0x34] = 0x153, /* Delete */
+    [0x35] = 0x14f, /* End */
+    [0x36] = 0x151, /* Page Down */
+    [0x37] = 0x047, /* KP 7 */
+    [0x38] = 0x048, /* KP 8 */
+    [0x39] = 0x049, /* KP 9 */
+    [0x3a] = 0x04e, /* KP + */
+    [0x3b] = 0x03a, /* Caps */
+    [0x3c] = 0x01e, /* A */
+    [0x3d] = 0x01f, /* S */
+    [0x3e] = 0x020, /* D */
+    [0x3f] = 0x021, /* F */
+    [0x40] = 0x022, /* G */
+    [0x41] = 0x023, /* H */
+    [0x42] = 0x024, /* J */
+    [0x43] = 0x025, /* K */
+    [0x44] = 0x026, /* L */
+    [0x45] = 0x027, /* ; */
+    [0x46] = 0x028, /* ' */
+    [0x47] = 0x01c, /* ENTER */
+    [0x48] = 0x04b, /* KP 4 */
+    [0x49] = 0x04c, /* KP 5 */
+    [0x4a] = 0x04d, /* KP 6 */
+    [0x4b] = 0x02a, /* Left Shift */
+    [0x4c] = 0x02c, /* Z */
+    [0x4d] = 0x02d, /* X */
+    [0x4e] = 0x02e, /* C */
+    [0x4f] = 0x02f, /* V */
+    [0x50] = 0x030, /* B */
+    [0x51] = 0x031, /* N */
+    [0x52] = 0x032, /* M */
+    [0x53] = 0x033, /* , */
+    [0x54] = 0x034, /* . */
+    [0x55] = 0x035, /* / */
+    [0x56] = 0x036, /* Right Shift */
+    [0x57] = 0x148, /* Up Arrow */
+    [0x58] = 0x04f, /* KP 1 */
+    [0x59] = 0x050, /* KP 2 */
+    [0x5a] = 0x051, /* KP 3 */
+    [0x5b] = 0x11c, /* KP Enter */
+    [0x5c] = 0x01d, /* Left Control */
+    [0x5d] = 0x038, /* Left Alt */
+    [0x5e] = 0x039, /* Space */
+    [0x5f] = 0x138, /* Right Alt */
+    [0x60] = 0x11d, /* Right Control */
+    [0x61] = 0x14b, /* Left Arrow */
+    [0x62] = 0x150, /* Down Arrow */
+    [0x63] = 0x14d, /* Right Arrow */
+    [0x64] = 0x052, /* KP 0 */
+    [0x65] = 0x053, /* KP . */
+    [0x66] = 0x15b, /* Left Gui */
+    [0x67] = 0x15c, /* Right Gui */
+    [0x68] = 0x15d, /* Menu */
+    [0x69] = 0x056, /* < */
+    [0x6a] = 0x07d, /* Yen (macron key, japanese) */
+    [0x6b] = 0x073, /* Ro (\\ key, japanese) */
+    [0x6c] = 0x07b, /* Muhenkan, key left to spacebar, japanese */
+    [0x6d] = 0x079, /* Henkan, first key right to spacebar, japanese */
+    [0x6e] = 0x070, /* Katakana/Hiragana, second key right to spacebar, japanese */
+    [0x70] = 0x07e, /* Keypad . on Brazilian ABNT2 */
+    [0x7e] = 0x054, /* SystReq */
+};
+
+static HWND hwnd_from_cookie(uint64_t cookie)
+{
+    return (HWND)(UINT_PTR)cookie;
+}
+
+static void send_mouse(HWND hwnd, DWORD flags, int x, int y, DWORD data)
+{
+    INPUT input = {0};
+
+    input.type = INPUT_MOUSE;
+    input.mi.dx = x;
+    input.mi.dy = y;
+    input.mi.mouseData = data;
+    input.mi.dwFlags = flags;
+    /* Hardware input uses screen coordinates for MOUSEEVENTF_ABSOLUTE, not the 0-65535 range
+     * of SendInput (server/queue.c, queue_mouse_message). */
+    NtUserSendHardwareInput(hwnd, SEND_HWMSG_RAWINPUT, &input, 0);
+}
+
+/* win32u holds back pure moves sent through NtUserSendHardwareInput and sends them to the
+ * server only with the next button or wheel input, a move for another window, or an empty
+ * input for no window (dlls/win32u/input.c, accum_mouse_motion; winewayland sends that at the
+ * end of each batch of pointer events). Without it, a drag reaches the program only when the
+ * button is released: no selection while dragging, no highlight under the pointer in menus. */
+static void flush_mouse_motion(void)
+{
+    INPUT input = {0};
+
+    input.type = INPUT_MOUSE;
+    NtUserSendHardwareInput(NULL, SEND_HWMSG_RAWINPUT, &input, 0);
+}
+
+static void mouse_button(HWND hwnd, const struct be_event *event)
+{
+    static const DWORD down_flags[] = { MOUSEEVENTF_LEFTDOWN, MOUSEEVENTF_RIGHTDOWN,
+                                        MOUSEEVENTF_MIDDLEDOWN, MOUSEEVENTF_XDOWN, MOUSEEVENTF_XDOWN };
+    static const DWORD up_flags[] = { MOUSEEVENTF_LEFTUP, MOUSEEVENTF_RIGHTUP,
+                                      MOUSEEVENTF_MIDDLEUP, MOUSEEVENTF_XUP, MOUSEEVENTF_XUP };
+    DWORD data = 0;
+
+    if (event->button < 0 || event->button >= ARRAY_SIZE(down_flags)) return;
+    if (event->button == BE_BUTTON_X1) data = XBUTTON1;
+    if (event->button == BE_BUTTON_X2) data = XBUTTON2;
+    /* With the position, so that the click lands where the pointer is now. */
+    send_mouse(hwnd, (event->down ? down_flags : up_flags)[event->button] | MOUSEEVENTF_MOVE |
+               MOUSEEVENTF_ABSOLUTE, event->x, event->y, data);
+}
+
+static void mouse_wheel(HWND hwnd, const struct be_event *event)
+{
+    /* One Haiku notch is one WHEEL_DELTA. Haiku's vertical delta is positive downwards,
+     * Windows' upwards; both horizontal ones are positive to the right. */
+    int y = (int)lroundf(-event->wheel_y * WHEEL_DELTA);
+    int x = (int)lroundf(event->wheel_x * WHEEL_DELTA);
+
+    if (y) send_mouse(hwnd, MOUSEEVENTF_WHEEL, 0, 0, y);
+    if (x) send_mouse(hwnd, MOUSEEVENTF_HWHEEL, 0, 0, x);
+}
+
+static void key(HWND hwnd, const struct be_event *event)
+{
+    INPUT input = {0};
+    WORD scan = 0;
+
+    if (event->keycode >= 0 && event->keycode < ARRAY_SIZE(keycode_to_scan))
+        scan = keycode_to_scan[event->keycode];
+    TRACE_(key)("hwnd %p keycode %#x scan %#x %s\n", hwnd, event->keycode, scan, event->down ? "down" : "up");
+    if (!scan) return;
+
+    /* win32u turns the scancode into a virtual key with the keyboard layout's tables
+     * (dlls/win32u/message.c, send_hardware_message). */
+    input.type = INPUT_KEYBOARD;
+    input.ki.wScan = (scan & 0x300) ? scan + 0xdf00 : scan;
+    input.ki.dwFlags = KEYEVENTF_SCANCODE;
+    if (scan & ~0xff) input.ki.dwFlags |= KEYEVENTF_EXTENDEDKEY;
+    if (!event->down) input.ki.dwFlags |= KEYEVENTF_KEYUP;
+    NtUserSendHardwareInput(hwnd, 0, &input, 0);
+}
+
+static void handle_event(const struct be_event *event)
+{
+    HWND hwnd = hwnd_from_cookie(event->cookie);
+
+    switch (event->type)
+    {
+    case BE_EVENT_MOUSE_MOVE:
+        send_mouse(hwnd, MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE, event->x, event->y, 0);
+        /* Consecutive moves are already merged in the queue; send this one now unless more
+         * events are waiting, which flush it themselves or come back here. */
+        if (!be_event_pending()) flush_mouse_motion();
+        break;
+    case BE_EVENT_MOUSE_BUTTON:
+        mouse_button(hwnd, event);
+        break;
+    case BE_EVENT_MOUSE_WHEEL:
+        mouse_wheel(hwnd, event);
+        break;
+    case BE_EVENT_KEY:
+        key(hwnd, event);
+        break;
+    case BE_EVENT_ACTIVATE:
+        /* Foreground changes happen on the window's own thread (WindowMessage). */
+        TRACE("hwnd %p %s\n", hwnd, event->down ? "activated" : "deactivated");
+        NtUserPostMessage(hwnd, WM_RENKU_ACTIVATE, event->down, 0);
+        break;
+    case BE_EVENT_CLOSE:
+        TRACE("hwnd %p close\n", hwnd);
+        NtUserPostMessage(hwnd, WM_SYSCOMMAND, SC_CLOSE, 0);
+        break;
+    case BE_EVENT_FRAME:
+        NtUserPostMessage(hwnd, WM_RENKU_FRAME_CHANGED, 0, 0);
+        break;
+    case BE_EVENT_MINIMIZE:
+        /* As from a Windows title bar or taskbar; the program may refuse. */
+        TRACE("hwnd %p %s\n", hwnd, event->down ? "minimize" : "restore");
+        NtUserPostMessage(hwnd, WM_SYSCOMMAND, event->down ? SC_MINIMIZE : SC_RESTORE, 0);
+        break;
+    case BE_EVENT_ZOOM:
+        TRACE("hwnd %p zoom\n", hwnd);
+        NtUserPostMessage(hwnd, WM_SYSCOMMAND,
+                          (NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_MAXIMIZE) ? SC_RESTORE : SC_MAXIMIZE, 0);
+        break;
+    }
+}
+
+/* The driver's event thread, started by DllMain on the PE side so that it is a Wine thread
+ * and may call win32u. It never returns. Everything it does is a server request that queues
+ * input or posts a message, so a program that stops reading its messages does not hold it
+ * up. */
+NTSTATUS renku_unix_event_loop(void *arg)
+{
+    struct be_event event;
+
+    for (;;)
+    {
+        be_event_wait(&event);
+        handle_event(&event);
+    }
+    return STATUS_SUCCESS;
+}
diff --git a/dlls/winerenku.drv/renku.h b/dlls/winerenku.drv/renku.h
index 7eeb6d13..5af305e6 100644
--- a/dlls/winerenku.drv/renku.h
+++ b/dlls/winerenku.drv/renku.h
@@ -38,6 +38,13 @@
 #include "unixlib.h"
 #include "renku_be.h"
 
+/* Messages the event thread posts to a window, handled by WindowMessage on its thread. */
+enum renku_window_message
+{
+    WM_RENKU_ACTIVATE = WM_WINE_FIRST_DRIVER_MSG,  /* wp: activated (1) or deactivated (0) */
+    WM_RENKU_FRAME_CHANGED,                        /* the BWindow moved or was resized */
+};
+
 /* display.c */
 extern UINT RENKU_UpdateDisplayDevices(const struct gdi_device_manager *manager, void *param);
 
@@ -54,10 +61,17 @@ extern void RENKU_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint
 extern BOOL RENKU_WindowPosChanging(HWND hwnd, UINT swp_flags, BOOL shaped,
                                     const struct window_rects *rects);
 
+extern void RENKU_ActivateWindow(HWND hwnd, HWND previous);
+extern LRESULT RENKU_WindowMessage(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp);
+
+/* event.c */
+extern NTSTATUS renku_unix_event_loop(void *arg);
+
 /* surface.c */
 extern struct window_surface *renku_surface_create(HWND hwnd, struct be_window *window,
                                                    const RECT *rect);
 extern struct be_bitmap *renku_surface_bitmap(struct window_surface *surface);
+extern void renku_surface_retire(struct window_surface *surface);
 
 /* UTF-8 copy of a Win32 string, malloc()ed; NULL on failure. */
 extern char *renku_utf8_from_wstr(const WCHAR *str);
diff --git a/dlls/winerenku.drv/renku_be.h b/dlls/winerenku.drv/renku_be.h
index 6f36bdc0..db616b9c 100644
--- a/dlls/winerenku.drv/renku_be.h
+++ b/dlls/winerenku.drv/renku_be.h
@@ -25,8 +25,10 @@
  * Threading rules (see the commit message of the driver patch for the evidence):
  *   - every function here may be called from any Win32 thread;
  *   - none of them waits for a Be looper thread, except be_app_start() and be_screen_*(),
- *     which wait for the BApplication and app_server, never for a Win32 thread;
- *   - Be threads never call into Wine. */
+ *     which wait for the BApplication and app_server, never for a Win32 thread, and
+ *     be_event_wait(), which waits for the next event;
+ *   - Be threads never call into Wine. What Wine has to hear about (input, activation,
+ *     close requests) they put in the event queue, which one Wine thread drains. */
 
 #ifndef __WINE_RENKU_BE_H
 #define __WINE_RENKU_BE_H
@@ -67,17 +69,36 @@ enum be_window_style
     BE_WINDOW_BORDERLESS,  /* Wine draws everything */
 };
 
+/* What the decorator offers, and how app_server treats the window. */
+enum be_window_flags
+{
+    BE_WINDOW_AVOID_FOCUS = 0x01,  /* never activated, not even by a click (B_AVOID_FOCUS) */
+    BE_WINDOW_RESIZABLE   = 0x02,
+    BE_WINDOW_MINIMIZABLE = 0x04,
+    BE_WINDOW_ZOOMABLE    = 0x08,
+    BE_WINDOW_CLOSABLE    = 0x10,
+};
+
 /* Created hidden, its looper already running. frame is the area Wine draws, which becomes the
- * BWindow's Frame(); the decorator, if any, is drawn around it. */
-struct be_window *be_window_create(enum be_window_style style, const struct be_rect *frame,
-                                   const char *title_utf8);
+ * BWindow's Frame(); the decorator, if any, is drawn around it. flags is a set of
+ * be_window_flags. cookie comes back in every event the window sends. */
+struct be_window *be_window_create(enum be_window_style style, unsigned int flags,
+                                   const struct be_rect *frame, const char *title_utf8,
+                                   uint64_t cookie);
 void be_window_add_ref(struct be_window *window);
 /* Drops a reference. The last one also closes the BWindow. */
 void be_window_release(struct be_window *window);
 
 void be_window_set_frame(struct be_window *window, const struct be_rect *frame);
 void be_window_set_visible(struct be_window *window, int visible);
-void be_window_set_style(struct be_window *window, enum be_window_style style);
+void be_window_set_style(struct be_window *window, enum be_window_style style, unsigned int flags);
+/* Minimized windows are listed in the Deskbar, hidden ones are not. */
+void be_window_set_minimized(struct be_window *window, int minimized);
+/* The BWindow's frame now, after every change posted to it before this call. Waits for the
+ * window's looper. Returns 0 on success. */
+int be_window_get_frame(struct be_window *window, struct be_rect *frame);
+/* Make it the active window, unless it already is. */
+void be_window_activate(struct be_window *window);
 void be_window_set_title(struct be_window *window, const char *title_utf8);
 /* Draw bitmap (or nothing, if NULL) with its top-left pixel at (x, y) in window coordinates.
  * The window takes its own reference. */
@@ -85,6 +106,47 @@ void be_window_set_bitmap(struct be_window *window, struct be_bitmap *bitmap, in
 /* Redraw rect, in window coordinates. */
 void be_window_invalidate(struct be_window *window, const struct be_rect *rect);
 
+/* Events from the Be side, in the order they happened. */
+enum be_event_type
+{
+    BE_EVENT_MOUSE_MOVE,    /* x, y */
+    BE_EVENT_MOUSE_BUTTON,  /* x, y, button, down */
+    BE_EVENT_MOUSE_WHEEL,   /* wheel_x, wheel_y: notches, positive is down and right */
+    BE_EVENT_KEY,           /* keycode, down */
+    BE_EVENT_ACTIVATE,      /* down: activated (1) or deactivated (0) */
+    BE_EVENT_CLOSE,         /* the decorator's close button */
+    BE_EVENT_FRAME,         /* moved or resized; be_window_get_frame() says where it is now */
+    BE_EVENT_MINIMIZE,      /* down: minimize (1) or restore (0), from the decorator or the Deskbar */
+    BE_EVENT_ZOOM,          /* the decorator's zoom button */
+};
+
+enum be_mouse_button
+{
+    BE_BUTTON_LEFT,
+    BE_BUTTON_RIGHT,
+    BE_BUTTON_MIDDLE,
+    BE_BUTTON_X1,
+    BE_BUTTON_X2,
+};
+
+struct be_event
+{
+    enum be_event_type type;
+    uint64_t cookie;          /* the window's, from be_window_create() */
+    int32_t x, y;             /* pointer position, screen coordinates */
+    int32_t button;           /* enum be_mouse_button */
+    int32_t down;
+    int32_t keycode;          /* a Haiku raw key code (the "key" field of B_KEY_DOWN) */
+    float wheel_x, wheel_y;
+};
+
+/* Waits for the next event. Meant for one thread only. */
+void be_event_wait(struct be_event *event);
+/* Whether another event is already waiting. */
+int be_event_pending(void);
+/* Whether app_server reports one of this process's windows as active. */
+int be_any_window_active(void);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/dlls/winerenku.drv/renku_main.c b/dlls/winerenku.drv/renku_main.c
index 7efa4b3b..665f3048 100644
--- a/dlls/winerenku.drv/renku_main.c
+++ b/dlls/winerenku.drv/renku_main.c
@@ -49,15 +49,18 @@ char *renku_utf8_from_wstr(const WCHAR *str)
 }
 
 /* Only what win32u cannot do without a window system is here; everything else is win32u's
- * own default (dlls/win32u/driver.c). Input, focus, cursors, clipboard and the other entries
- * come in later patches. */
+ * own default (dlls/win32u/driver.c). Keyboard and mouse input do not go through this table:
+ * the event thread (event.c) sends them. Cursors, clipboard and the other entries come in
+ * later patches. */
 static const struct user_driver_funcs renku_funcs =
 {
+    .pActivateWindow = RENKU_ActivateWindow,
     .pCreateWindowSurface = RENKU_CreateWindowSurface,
     .pDestroyWindow = RENKU_DestroyWindow,
     .pGetWindowStyleMasks = RENKU_GetWindowStyleMasks,
     .pSetWindowText = RENKU_SetWindowText,
     .pUpdateDisplayDevices = RENKU_UpdateDisplayDevices,
+    .pWindowMessage = RENKU_WindowMessage,
     .pWindowPosChanged = RENKU_WindowPosChanged,
     .pWindowPosChanging = RENKU_WindowPosChanging,
 };
@@ -72,6 +75,7 @@ static NTSTATUS renku_unix_init(void *arg)
 const unixlib_entry_t __wine_unix_call_funcs[] =
 {
     renku_unix_init,
+    renku_unix_event_loop,
 };
 
 C_ASSERT(ARRAYSIZE(__wine_unix_call_funcs) == renku_unix_func_count);
@@ -81,6 +85,7 @@ C_ASSERT(ARRAYSIZE(__wine_unix_call_funcs) == renku_unix_func_count);
 const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
 {
     renku_unix_init,
+    renku_unix_event_loop,
 };
 
 C_ASSERT(ARRAYSIZE(__wine_unix_call_wow64_funcs) == renku_unix_func_count);
diff --git a/dlls/winerenku.drv/surface.c b/dlls/winerenku.drv/surface.c
index 818ed679..ce8efe09 100644
--- a/dlls/winerenku.drv/surface.c
+++ b/dlls/winerenku.drv/surface.c
@@ -43,6 +43,17 @@ struct renku_surface
     struct window_surface header;
     struct be_bitmap     *bitmap;   /* owned */
     struct be_window     *window;   /* referenced; safe to use after the BWindow has gone */
+    LONG                  state;    /* enum surface_state */
+};
+
+/* A new surface (a resize makes one) is blank until win32u has drawn into it and flushed.
+ * The view keeps showing the previous bitmap until then: swapping at once showed the whole
+ * window white for a moment on every step of a resize. */
+enum surface_state
+{
+    SURFACE_NEW,      /* not flushed yet; the view still shows the previous one */
+    SURFACE_SHOWN,    /* the view shows it */
+    SURFACE_RETIRED,  /* replaced by another surface; it must never be shown again */
 };
 
 static const struct window_surface_funcs renku_surface_funcs;
@@ -81,6 +92,10 @@ static BOOL renku_surface_flush(struct window_surface *window_surface, const REC
     area.top = rect->top + dirty->top;
     area.right = rect->left + dirty->right;
     area.bottom = rect->top + dirty->bottom;
+    /* rect places the surface in the visible rect, which is the BWindow's frame. Posted before
+     * the invalidation, so the view draws the new bitmap. */
+    if (InterlockedCompareExchange(&surface->state, SURFACE_SHOWN, SURFACE_NEW) == SURFACE_NEW)
+        be_window_set_bitmap(surface->window, surface->bitmap, rect->left, rect->top);
     be_window_invalidate(surface->window, &area);
 
     /* Not yet done: window shapes (SetWindowRgn) and layered windows; see the plan, phase 4. */
@@ -121,7 +136,8 @@ struct window_surface *renku_surface_create(HWND hwnd, struct be_window *window,
         ERR("no BBitmap for %p, %dx%d\n", hwnd, width, height);
         return NULL;
     }
-    /* The view may draw it before the first flush; win32u starts its own bits white too. */
+    /* Shown from the first flush on, which may cover only part of it: the rest starts white,
+     * as win32u's own bits do. */
     bits = be_bitmap_bits(bitmap, &stride);
     memset(bits, 0xff, (size_t)stride * height);
 
@@ -153,3 +169,11 @@ struct be_bitmap *renku_surface_bitmap(struct window_surface *window_surface)
     struct renku_surface *surface = get_renku_surface(window_surface);
     return surface ? surface->bitmap : NULL;
 }
+
+/* window_surface replaced by another one, or the window has none any more: a late first
+ * flush of it must not put its bitmap back in the view. */
+void renku_surface_retire(struct window_surface *window_surface)
+{
+    struct renku_surface *surface = get_renku_surface(window_surface);
+    if (surface) InterlockedExchange(&surface->state, SURFACE_RETIRED);
+}
