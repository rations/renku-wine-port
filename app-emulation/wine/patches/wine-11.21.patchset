+ */
+
+#include <windows.h>
+
+#include <windows.h>
+
+LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
+
+1 RT_MANIFEST rundll32.manifest
diff --git a/programs/rundll32/rundll32.manifest b/programs/rundll32/rundll32.manifest
new file mode 100644
