index 4e365d37..5ee7c494 100644
--- a/dlls/winerenku.drv/be_private.h
+++ b/dlls/winerenku.drv/be_private.h
@@ -45,4 +45,8 @@ private:
     sigset_t old_mask;
 };
 
+/* Queues an event for be_event_wait(). Called on Be threads; it takes a mutex that the Wine
+ * side holds only while copying an event out, never while calling Wine or the Be API. */
+void be_event_post(const struct be_event *event);
+
 #endif /* __WINE_RENKU_BE_PRIVATE_H */
