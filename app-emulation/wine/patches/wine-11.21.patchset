+/* The BWindow of a top-level window that is shown on screen, with a reference for the caller;
+ * NULL for any other window. */
+struct be_window *renku_window_get(HWND hwnd)
+{
+    struct renku_win_data *data;
+    struct be_window *window = NULL;
+
+    if (!(data = get_win_data(hwnd))) return NULL;
+    if (data->window && data->visible && !data->minimized)
+    {
+        window = data->window;
+        be_window_add_ref(window);
+    }
+    release_win_data(data);
+    return window;
+}
