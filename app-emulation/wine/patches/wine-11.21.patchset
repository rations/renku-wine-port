 dlls/winerenku.drv/renku.h       |  65 ++++++
 dlls/winerenku.drv/renku_be.h    |  92 +++++++++
 dlls/winerenku.drv/renku_main.c  |  88 ++++++++
 dlls/winerenku.drv/surface.c     | 155 ++++++++++++++
 dlls/winerenku.drv/unixlib.h     |  32 +++
 dlls/winerenku.drv/window.c      | 308 ++++++++++++++++++++++++++++
 13 files changed, 1495 insertions(+)
