2.47.3


From a4f1985c9c1f80606219eda7e69329538c5a2b95 Mon Sep 17 00:00:00 2001
From: rations <ehqcar@proton.me>
Date: Wed, 11 Nov 2026 18:48:25 +1000
Subject: [PATCH 19/20] winerenku.drv: Text clipboard, both ways, with
 RenkuOS's.

Wine's clipboard and RenkuOS's system clipboard were separate: text
copied in a Windows program could not be pasted into a RenkuOS one, or
the other way round. Like winemac, the driver now gives the clipboard
manager window, which explorer runs on a thread of its own
(programs/explorer/desktop.c, clipboard_thread), a window procedure
(pClipboardWindowProc) that keeps the two the same, for text, for every
Wine program of the desktop at once.

- RenkuOS to Wine. A BLooper of the driver's own watches the system
  clipboard (BClipboard::StartWatching, be_clipboard.cpp). When another
  program changes it, the event thread posts WM_USER to the clipboard
  window, and the window takes Wine's clipboard and puts the text on it
  as CF_UNICODETEXT; user32 makes CF_TEXT and CF_OEMTEXT from that when
  a program asks. What was on the clipboard before Wine started is
  taken the same way when the window is created. explorer passes only
  WM_NCCREATE, WM_CLIPBOARDUPDATE, WM_RENDERFORMAT, WM_TIMER,
  WM_DESTROYCLIPBOARD and WM_USER to the driver, so WM_USER is the
  message (winemac uses it too).
- Wine to RenkuOS. WM_CLIPBOARDUPDATE (the window is a clipboard format
  listener) says a Windows program changed Wine's clipboard. Its
  CF_UNICODETEXT, which win32u renders from CF_TEXT when only that was
  set, goes to the system clipboard as "text/plain" UTF-8, as BTextView
  keeps it. Without text, the system clipboard is emptied, as a copy of
  anything else replaces what was there on Windows.
- No loops. The window ignores updates while it owns Wine's clipboard
  (its own imports). The watcher ignores the change notice of the
  driver's own Commit(): it remembers the registrar's change count that
  Commit() produced (LocalCount()) and compares it with SystemCount(),
  under a mutex held across Commit(), as the notice can arrive before
  Commit() returns.
- Line ends become CR LF for Windows and LF for RenkuOS, as winemac
  converts them. CF_UNICODETEXT ends at its NUL, whatever its size.

BClipboard and BLooper need no BApplication (src/kits/app/Clipboard.cpp,
Looper.cpp), so explorer, which has no windows of its own, still does
not start one and stays out of the Deskbar. The looper thread is
spawned with Wine's signals blocked, as the other Be threads are.

Verified in the RenkuOS build VM with notepad and StyledEdit, from the
build tree: text copied in StyledEdit (menu and Alt+C) pastes into
notepad (menu and Ctrl+V), and text copied in notepad (menu and Ctrl+C,
the trace shows 115 bytes exported) pastes into StyledEdit from its
menu. Alt+V in StyledEdit did not reach the guest: QEMU's window took
it for its own View menu. Not verified: non-ASCII text and the line
end conversion, programs that render the clipboard late (delayed
rendering), very large text. Not done: images and other formats are not
carried either way.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/winerenku.drv/Makefile.in      |   2 +
 dlls/winerenku.drv/be_clipboard.cpp | 130 +++++++++++++++++++++
 dlls/winerenku.drv/clipboard.c      | 173 ++++++++++++++++++++++++++++
 dlls/winerenku.drv/event.c          |   4 +
 dlls/winerenku.drv/renku.h          |   8 ++
 dlls/winerenku.drv/renku_be.h       |  12 ++
 dlls/winerenku.drv/renku_main.c     |   4 +-
 7 files changed, 331 insertions(+), 2 deletions(-)
 create mode 100644 dlls/winerenku.drv/be_clipboard.cpp
 create mode 100644 dlls/winerenku.drv/clipboard.c

diff --git a/dlls/winerenku.drv/Makefile.in b/dlls/winerenku.drv/Makefile.in
index 627baeda..7991a4cf 100644
--- a/dlls/winerenku.drv/Makefile.in
+++ b/dlls/winerenku.drv/Makefile.in
@@ -6,9 +6,11 @@ VER_FILEDESCRIPTION_STR = "Wine RenkuOS driver"
 
 SOURCES = \
 	be_app.cpp \
+	be_clipboard.cpp \
 	be_event.cpp \
 	be_keymap.cpp \
 	be_window.cpp \
+	clipboard.c \
 	display.c \
 	dllmain.c \
 	event.c \
diff --git a/dlls/winerenku.drv/be_clipboard.cpp b/dlls/winerenku.drv/be_clipboard.cpp
new file mode 100644
index 00000000..b922ce98
--- /dev/null
+++ b/dlls/winerenku.drv/be_clipboard.cpp
@@ -0,0 +1,130 @@
+/*
+ * RenkuOS driver: the system clipboard
+ *
+ * Copyright 2026 rations
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "be_private.h"
+
+#include <Clipboard.h>
+#include <Looper.h>
+#include <Message.h>
+
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Neither BClipboard nor BLooper needs a BApplication (src/kits/app/Clipboard.cpp and
+ * Looper.cpp; Commit() only adds be_app_messenger as the data source), so the process that
+ * runs Wine's clipboard manager, explorer, does not start one, and does not appear in the
+ * Deskbar. The registrar keeps the clipboard and counts its changes: Commit() leaves the new
+ * count in LocalCount(), and SystemCount() asks for the current one. */
+
+namespace {
+
+pthread_mutex_t clipboard_mutex = PTHREAD_MUTEX_INITIALIZER;
+BClipboard *clipboard;
+uint32 own_count;  /* the count our last Commit() produced */
+
+class ClipboardWatcher : public BLooper
+{
+public:
+    ClipboardWatcher(uint64 cookie) : BLooper("winerenku clipboard"), fCookie(cookie) {}
+
+    void MessageReceived(BMessage *msg) override
+    {
+        if (msg->what != B_CLIPBOARD_CHANGED)
+        {
+            BLooper::MessageReceived(msg);
+            return;
+        }
+        /* Our own Commit() notifies us too; Wine already has that text. */
+        uint32 count = clipboard->SystemCount();
+        pthread_mutex_lock(&clipboard_mutex);
+        bool own = count == own_count;
+        pthread_mutex_unlock(&clipboard_mutex);
+        if (own) return;
+
+        struct be_event event = {};
+        event.type = BE_EVENT_CLIPBOARD;
+        event.cookie = fCookie;
+        be_event_post(&event);
+    }
+
+private:
+    uint64 fCookie;
+};
+
+}  /* namespace */
+
+extern "C" int be_clipboard_watch(uint64_t cookie)
+{
+    ClipboardWatcher *watcher;
+
+    if (clipboard) return -1;
+    clipboard = new BClipboard(NULL);  /* NULL is the "system" clipboard, be_clipboard's */
+    watcher = new ClipboardWatcher(cookie);
+    {
+        be_spawn_guard guard;
+        watcher->Run();
+    }
+    if (clipboard->StartWatching(BMessenger(watcher)) != B_OK) return -1;
+    return 0;
+}
+
+extern "C" char *be_clipboard_get_text(size_t *size)
+{
+    const void *text;
+    ssize_t len;
+    char *ret = NULL;
+
+    if (!clipboard || !clipboard->Lock()) return NULL;  /* Lock() fetches the current data */
+    BMessage *data = clipboard->Data();
+    if (data && data->FindData("text/plain", B_MIME_TYPE, &text, &len) == B_OK && len >= 0 &&
+        (ret = (char *)malloc(len ? len : 1)))
+    {
+        memcpy(ret, text, len);
+        *size = len;
+    }
+    clipboard->Unlock();
+    return ret;
+}
+
+extern "C" int be_clipboard_set_text(const char *text, size_t size)
+{
+    status_t status = B_ERROR;
+
+    if (!clipboard || !clipboard->Lock()) return -1;
+    BMessage *data = clipboard->Data();
+    if (clipboard->Clear() == B_OK && data &&
+        (!text || data->AddData("text/plain", B_MIME_TYPE, text, size) == B_OK))
+    {
+        /* The mutex is held across Commit(): the watcher may hear of this change before
+         * Commit() returns, and it compares only once own_count is set. Commit() waits for
+         * the registrar, which never waits for the watcher, so this cannot deadlock. */
+        pthread_mutex_lock(&clipboard_mutex);
+        status = clipboard->Commit();
+        own_count = clipboard->LocalCount();
+        pthread_mutex_unlock(&clipboard_mutex);
+    }
+    clipboard->Unlock();
+    return status == B_OK ? 0 : -1;
+}
diff --git a/dlls/winerenku.drv/clipboard.c b/dlls/winerenku.drv/clipboard.c
new file mode 100644
index 00000000..6f7fc297
--- /dev/null
+++ b/dlls/winerenku.drv/clipboard.c
@@ -0,0 +1,173 @@
+/*
+ * RenkuOS driver: clipboard
+ *
+ * Copyright 2026 rations
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "renku.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(clipboard);
+
+/* Wine's clipboard and RenkuOS's system clipboard are kept the same, for text, by the
+ * clipboard manager window that the desktop process, explorer, runs on a thread of its own
+ * (programs/explorer/desktop.c, clipboard_thread): its window procedure is this driver's. So
+ * one process does it for every Wine program, as with winemac.
+ *
+ *   - RenkuOS -> Wine: a Be looper watches the system clipboard (be_clipboard.cpp). When
+ *     another program changes it, the event thread posts WM_RENKU_CLIPBOARD_CHANGED here, and
+ *     the window takes the clipboard and puts the text on it as CF_UNICODETEXT; user32
+ *     makes CF_TEXT and CF_OEMTEXT from it when a program asks.
+ *   - Wine -> RenkuOS: WM_CLIPBOARDUPDATE says a Windows program changed Wine's clipboard.
+ *     Its CF_UNICODETEXT (which win32u makes from CF_TEXT if needed) goes to the system
+ *     clipboard as "text/plain"; without text, the system clipboard is emptied, as a Windows
+ *     copy replaces what was there.
+ *
+ * Line ends become CR LF for Windows and LF for RenkuOS, as winemac converts them. Only
+ * text is done; images and other formats are not carried either way yet. */
+
+static HWND clipboard_hwnd;
+
+static void import_from_renku(void)
+{
+    struct set_clipboard_params params = {0};
+    size_t size = 0, i, j, cr = 0;
+    char *text = be_clipboard_get_text(&size), *crlf = NULL;
+    WCHAR *wtext = NULL;
+    DWORD wsize;
+
+    TRACE("%s\n", text ? "text" : "no text");
+
+    if (text)
+    {
+        for (i = 0; i < size; i++) if (text[i] == '\n' && (!i || text[i - 1] != '\r')) cr++;
+        if (!(crlf = malloc(size + cr))) goto done;
+        for (i = j = 0; i < size; i++)
+        {
+            if (text[i] == '\n' && (!i || text[i - 1] != '\r')) crlf[j++] = '\r';
+            crlf[j++] = text[i];
+        }
+        RtlUTF8ToUnicodeN(NULL, 0, &wsize, crlf, j);
+        if (!(wtext = malloc(wsize + sizeof(WCHAR)))) goto done;
+        RtlUTF8ToUnicodeN(wtext, wsize, &wsize, crlf, j);
+        wtext[wsize / sizeof(WCHAR)] = 0;
+        params.data = wtext;
+        params.size = wsize + sizeof(WCHAR);
+    }
+
+    if (!NtUserOpenClipboard(clipboard_hwnd, 0))
+    {
+        WARN("cannot open the clipboard\n");
+        goto done;
+    }
+    NtUserEmptyClipboard();
+    if (wtext) NtUserSetClipboardData(CF_UNICODETEXT, 0, &params);
+    NtUserCloseClipboard();
+
+done:
+    free(wtext);
+    free(crlf);
+    free(text);
+}
+
+static void export_to_renku(void)
+{
+    struct get_clipboard_params params = { .data_only = TRUE, .size = 1024 };
+    WCHAR *wtext = NULL;
+    size_t len = 0, i, j;
+    DWORD size;
+    char *text;
+
+    if (!NtUserOpenClipboard(clipboard_hwnd, 0))
+    {
+        WARN("cannot open the clipboard\n");
+        return;
+    }
+    for (;;)
+    {
+        if (!(params.data = malloc(params.size))) break;
+        if (NtUserGetClipboardData(CF_UNICODETEXT, &params))
+        {
+            wtext = params.data;
+            len = params.size / sizeof(WCHAR);
+            break;
+        }
+        free(params.data);
+        if (!params.data_size) break;  /* no text on the clipboard */
+        params.size = params.data_size;
+        params.data_size = 0;
+    }
+    NtUserCloseClipboard();
+
+    if (!wtext)
+    {
+        TRACE("no text, emptying the system clipboard\n");
+        be_clipboard_set_text(NULL, 0);
+        return;
+    }
+
+    /* CF_UNICODETEXT ends at its NUL, whatever the size of its memory. */
+    for (i = 0; i < len && wtext[i]; i++) {}
+    len = i;
+    RtlUnicodeToUTF8N(NULL, 0, &size, wtext, len * sizeof(WCHAR));
+    if ((text = malloc(size ? size : 1)))
+    {
+        RtlUnicodeToUTF8N(text, size, &size, wtext, len * sizeof(WCHAR));
+        for (i = j = 0; i < size; i++)
+            if (text[i] != '\r' || i + 1 >= size || text[i + 1] != '\n') text[j++] = text[i];
+        TRACE("%u bytes of text\n", (unsigned int)j);
+        be_clipboard_set_text(text, j);
+        free(text);
+    }
+    free(wtext);
+}
+
+/***********************************************************************
+ *           RENKU_ClipboardWindowProc
+ */
+LRESULT RENKU_ClipboardWindowProc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    switch (msg)
+    {
+    case WM_NCCREATE:
+        clipboard_hwnd = hwnd;
+        NtUserAddClipboardFormatListener(hwnd);
+        if (be_clipboard_watch((UINT_PTR)hwnd))
+            ERR("cannot watch the system clipboard\n");
+        /* What was copied before Wine started is there too. */
+        NtUserPostMessage(hwnd, WM_RENKU_CLIPBOARD_CHANGED, 0, 0);
+        return TRUE;
+    case WM_RENKU_CLIPBOARD_CHANGED:
+        import_from_renku();
+        return 0;
+    case WM_CLIPBOARDUPDATE:
+        /* Our own import comes back as an update too. */
+        if (NtUserGetClipboardOwner() == clipboard_hwnd) break;
+        export_to_renku();
+        break;
+    }
+    return NtUserMessageCall(hwnd, msg, wp, lp, NULL, NtUserDefWindowProc, FALSE);
+}
diff --git a/dlls/winerenku.drv/event.c b/dlls/winerenku.drv/event.c
index ff9b44dc..875dce49 100644
--- a/dlls/winerenku.drv/event.c
+++ b/dlls/winerenku.drv/event.c
@@ -291,6 +291,10 @@ static void handle_event(const struct be_event *event)
         TRACE("hwnd %p %s\n", hwnd, event->down ? "minimize" : "restore");
         NtUserPostMessage(hwnd, WM_SYSCOMMAND, event->down ? SC_MINIMIZE : SC_RESTORE, 0);
         break;
+    case BE_EVENT_CLIPBOARD:
+        TRACE("clipboard changed\n");
+        NtUserPostMessage(hwnd, WM_RENKU_CLIPBOARD_CHANGED, 0, 0);
+        break;
     case BE_EVENT_ZOOM:
         TRACE("hwnd %p zoom\n", hwnd);
         NtUserPostMessage(hwnd, WM_SYSCOMMAND,
