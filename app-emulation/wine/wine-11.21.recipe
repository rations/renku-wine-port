SUMMARY="Program which allows running Microsoft Windows programs"
DESCRIPTION="Wine is a program which allows running Microsoft Windows programs \
(including DOS, Windows 3.x, Win32, and Win64 executables) on Unix. \
On Haiku, 32-bit (Win32) programs also need a kernel with per-team LDT \
support; a stock kernel runs Win64 executables only."
HOMEPAGE="https://www.winehq.org/"
COPYRIGHT="1993-2026 the Wine project authors"
LICENSE="GNU LGPL v2.1"
REVISION="10"
SOURCE_URI="https://github.com/wine-mirror/wine/archive/refs/tags/wine-${portVersion}.tar.gz"
CHECKSUM_SHA256="046cb0519b7d385be7912304910ccde9e3c0268ebdce7ef35a3c14446cfb8029"
SOURCE_DIR="wine-wine-${portVersion}"
PATCHES="wine-$portVersion.patchset"
ADDITIONAL_FILES="wine.rdef.in"

ARCHITECTURES="all !x86_gcc2"
#SECONDARY_ARCHITECTURES="x86" # Untested

PROVIDES="
	wine$secondaryArchSuffix = $portVersion
	cmd:wine$secondaryArchSuffix = $portVersion
	cmd:function_grep.pl
	cmd:msidb
	cmd:msiexec
	cmd:notepad
	cmd:regedit
	cmd:regsvr32
	cmd:widl
	cmd:wineboot
	cmd:winebuild
	cmd:winecfg
	cmd:wineconsole
	cmd:winecpp
	cmd:winedbg
	cmd:winedump
	cmd:winefile
	cmd:wineg++
	cmd:winegcc
	cmd:winemaker
	cmd:winemine
	cmd:winepath
	cmd:wineserver
	cmd:wmc
	cmd:wrc
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libfreetype$secondaryArchSuffix
	lib:libgnutls$secondaryArchSuffix
	lib:libosmesa$secondaryArchSuffix
	lib:libstdc++$secondaryArchSuffix
	lib:libusb_1.0$secondaryArchSuffix
	lib:libvulkan$secondaryArchSuffix
	"
# NOTE: no comment lines inside REQUIRES. haikuporter only strips '#' entries on
# the --update-dependencies path (RequiresUpdater.updateRequiresList); on the
# normal path they reach the resolver and dependency analysis dies with
# "'NoneType' object is not iterable". BUILD_REQUIRES is unaffected.
# No Wayland or xkb entries: this port builds --without-wayland; the native
# winerenku.drv replaces winewayland.drv, which is not built.
# lib:libosmesa (package mesa): winerenku.drv's OpenGL, dlopen()ed, so
# haikuporter cannot see it. Without it there is no GL and no Direct3D.
# lib:libgnutls: Wine dlopens libgnutls.so.30 for secur32/bcrypt/crypt32, so
# haikuporter cannot see it. Without it TLS fails ("secure connections will not
# be available") and iLok reports a ServerConnectionError.
# lib:libstdc++ (package gcc_syslibs): winerenku.so is C++ and links libbe and
# libstdc++.so.6. libbe.so itself ships in the haiku package.
# lib:libusb_1.0 (package libusb) is what wineusb.so links; plain lib:libusb is
# the 0.1 API from libusb_compat and is used by nothing here.
REPLACES="
	wine_bin
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	ffmpeg6${secondaryArchSuffix}_devel # Optional, min. v6 required
	gstreamer${secondaryArchSuffix}_devel # Optional
	gst_plugins_base${secondaryArchSuffix}_devel # Optional
	libgphoto2${secondaryArchSuffix}_devel # Optional
	libpcap${secondaryArchSuffix}_devel # Optional
	libusb${secondaryArchSuffix}_devel # Optional
	opensound$secondaryArchSuffix # Optional, for audio support
	samba4${secondaryArchSuffix}_devel # Optional
	sane_backends${secondaryArchSuffix}_devel # Optional
	devel:libdbus_1$secondaryArchSuffix # Optional
	devel:libfontconfig$secondaryArchSuffix # Optional
	devel:libfreetype$secondaryArchSuffix
	devel:libgnutls$secondaryArchSuffix
	devel:libkrb5$secondaryArchSuffix # Optional
	devel:libosmesa$secondaryArchSuffix # mesa_devel; configure fails without it
	devel:libopenal$secondaryArchSuffix # Optional
	devel:libopencl$secondaryArchSuffix # Optional
	devel:libopencl_headers$secondaryArchSuffix # Optional
	devel:libSDL2_2.0$secondaryArchSuffix # Optional
	devel:libvulkan$secondaryArchSuffix
	#devel:libX11$secondaryArchSuffix # xLibe_devel, needed if built --with-x
	"
BUILD_PREREQUIRES="
	cmd:autoconf
	cmd:automake
	cmd:bison
	cmd:cp
	cmd:flex
	cmd:gcc
	cmd:gettext
	cmd:ld
	cmd:make
	cmd:mkdepend
	cmd:sed
	cmd:pkg_config
	llvm21
	llvm21_clang
	llvm21_lld
	"

BUILD()
{
	autoreconf -i
	# --without-opengl: configure otherwise finds libEGL in the build chroot and
	# defines SONAME_LIBEGL. win32u then loads it at run time, its internal GL
	# context fails, and explorer /desktop hangs for good on a pthread_once, so
	# no prefix can be created. Without SONAME_LIBEGL, win32u's egl_init returns
	# FALSE. OpenGL comes from winerenku.drv's own OSMesa backend instead, which
	# configure looks for separately (GL/osmesa.h, libOSMesa) and requires.
	LDFLAGS=-lnetwork runConfigure ./configure \
		--enable-archs=i386,x86_64 \
		--disable-tests \
		--without-wayland --without-x --without-opengl

	make $jobArgs
}

INSTALL()
{
	make install

	# Generate the rdef
	local MAJOR="`echo "$portVersion" | cut -d. -f1`"
	local MIDDLE="`echo "$portVersion" | cut -d. -f2`"
	local LONG_INFO="$SUMMARY"
	sed \
		-e "s|@MAJOR@|$MAJOR|" \
		-e "s|@MIDDLE@|$MIDDLE|" \
		-e "s|@LONG_INFO@|$LONG_INFO|" \
		$portDir/additional-files/wine.rdef.in > wine.rdef

	addResourcesToBinaries wine.rdef $prefix/bin/wine # For Deskbar menu links
	addResourcesToBinaries wine.rdef $prefix/lib/wine/x86_64-unix/wine # For the actual Deskbar app entry

	# Make the main bin name uppercase then link it back
	mv $prefix/lib/wine/x86_64-unix/wine $prefix/lib/wine/x86_64-unix/Wine
	ln -s $prefix/lib/wine/x86_64-unix/Wine $prefix/lib/wine/x86_64-unix/wine

	# This link doesn't work when invoked from the Deskbar menu
	#addPreferencesDeskbarSymlink $prefix/bin/winecfg "Wine Configuration"
}
