+/* The BCursor is made here, on the calling thread (app_server answers at once and never waits
+ * for Wine), and the window's looper sets it on the view and deletes it. */
+static void send_cursor(struct be_window *window, BCursor *cursor)
+{
+    BMessage msg(MSG_SET_CURSOR);
+
+    if (!window || cursor->InitCheck() != B_OK)
+    {
+        delete cursor;
+        return;
+    }
+    msg.AddPointer("cursor", cursor);
+    if (window->messenger.SendMessage(&msg) != B_OK) delete cursor;
+}
+
+extern "C" void be_window_set_cursor(struct be_window *window, enum be_cursor_shape shape)
+{
+    if ((size_t)shape >= sizeof(kCursorIds) / sizeof(kCursorIds[0])) shape = BE_CURSOR_DEFAULT;
+    send_cursor(window, new BCursor(kCursorIds[shape]));
+}
+
+extern "C" void be_window_set_cursor_image(struct be_window *window, int width, int height,
+                                           int hot_x, int hot_y, const uint32_t *pixels)
+{
+    if (!window || width <= 0 || height <= 0) return;
+
+    /* Only its bits are read: BCursor sends them to app_server (AS_CREATE_CURSOR_BITMAP),
+     * which keeps its own copy. B_RGBA32 is what app_server draws a cursor from, and it
+     * expects the colour premultiplied (HWInterface::_DrawCursor). */
+    BBitmap bitmap(BRect(0, 0, width - 1, height - 1), B_BITMAP_NO_SERVER_LINK, B_RGBA32);
+    if (bitmap.InitCheck() != B_OK) return;
+    uint8 *dst = (uint8 *)bitmap.Bits();
+    for (int y = 0; y < height; y++, dst += bitmap.BytesPerRow())
+        memcpy(dst, pixels + y * width, width * 4);
+    send_cursor(window, new BCursor(&bitmap, BPoint(hot_x, hot_y)));
+}
