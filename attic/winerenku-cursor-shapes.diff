+
+/* Win32's standard pointers are shown as the system's own, the way winemac and winewayland
+ * show them, so they look like every other program's. Only the resources whose meaning is
+ * plain from Wine's own sources are listed; any other cursor is drawn from its bitmaps. */
+struct system_cursor
+{
+    WORD id;
+    enum be_cursor_shape shape;
+};
+
+static const struct system_cursor user32_cursors[] =
+{
+    { OCR_NORMAL,      BE_CURSOR_DEFAULT },
+    { OCR_IBEAM,       BE_CURSOR_I_BEAM },
+    { OCR_WAIT,        BE_CURSOR_PROGRESS },  /* Haiku has no busy pointer of its own */
+    { OCR_CROSS,       BE_CURSOR_CROSS_HAIR },
+    { OCR_SIZE,        BE_CURSOR_MOVE },
+    { OCR_SIZENWSE,    BE_CURSOR_RESIZE_NWSE },
+    { OCR_SIZENESW,    BE_CURSOR_RESIZE_NESW },
+    { OCR_SIZEWE,      BE_CURSOR_RESIZE_EW },
+    { OCR_SIZENS,      BE_CURSOR_RESIZE_NS },
+    { OCR_SIZEALL,     BE_CURSOR_MOVE },
+    { OCR_NO,          BE_CURSOR_NOT_ALLOWED },
+    { OCR_HAND,        BE_CURSOR_FOLLOW_LINK },
+    { OCR_APPSTARTING, BE_CURSOR_PROGRESS },
+    { OCR_HELP,        BE_CURSOR_HELP },
+    { 0 }
+};
+
+/* dlls/comctl32/comctl32.h */
+static const struct system_cursor comctl32_cursors[] =
+{
+    { 104 /* IDC_COPY */,        BE_CURSOR_COPY },
+    { 106 /* IDC_DIVIDER */,     BE_CURSOR_RESIZE_EW },
+    { 107 /* IDC_DIVIDEROPEN */, BE_CURSOR_RESIZE_EW },
+    { 0 }
+};
+
+/* dlls/ole32/olestd.h, the drag and drop pointers */
+static const struct system_cursor ole32_cursors[] =
+{
+    { 1 /* CURSOR_NODROP */, BE_CURSOR_NOT_ALLOWED },
+    { 3 /* CURSOR_COPY */,   BE_CURSOR_COPY },
+    { 4 /* CURSOR_LINK */,   BE_CURSOR_CREATE_LINK },
+    { 0 }
+};
+
+/* Spelled out: unix-side code has no 16-bit L"" literals (-fshort-wchar is for PE code). */
+static const struct
+{
+    WCHAR name[16];
+    const struct system_cursor *cursors;
+} module_cursors[] =
+{
+    { {'u','s','e','r','3','2','.','d','l','l',0},         user32_cursors },
+    { {'c','o','m','c','t','l','3','2','.','d','l','l',0}, comctl32_cursors },
+    { {'o','l','e','3','2','.','d','l','l',0},             ole32_cursors },
+};
+
+/* The system shape for a cursor loaded from one of the modules above, or -1. */
+static int system_shape(const WCHAR *module_path, const UNICODE_STRING *res_name)
+{
+    const struct system_cursor *cursors = NULL;
+    const WCHAR *module;
+    unsigned int i;
+    WORD id;
+
+    /* NtUserGetIconInfo gives a resource ID as the buffer itself, with no length. */
+    if (!module_path[0] || res_name->Length || !res_name->Buffer) return -1;
+    id = LOWORD(res_name->Buffer);
+    if ((module = wcsrchr(module_path, '\\'))) module++;
+    else module = module_path;
+
+    for (i = 0; i < ARRAY_SIZE(module_cursors); i++)
+        if (!wcsicmp(module, module_cursors[i].name)) cursors = module_cursors[i].cursors;
+    if (!cursors) return -1;
+    for (i = 0; cursors[i].id; i++)
+        if (cursors[i].id == id) return cursors[i].shape;
+    return -1;
+}
+
+static void init_bitmap_info(BITMAPINFO *info, int width, int height, int bpp)
+{
+    memset(&info->bmiHeader, 0, sizeof(info->bmiHeader));
+    info->bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    info->bmiHeader.biWidth = width;
+    info->bmiHeader.biHeight = -height;  /* top row first */
+    info->bmiHeader.biPlanes = 1;
+    info->bmiHeader.biBitCount = bpp;
+    info->bmiHeader.biCompression = BI_RGB;
+}
+
+/* A 1-bpp bitmap as a top-down DIB, rows padded to 32 bits. */
+static BYTE *get_mono_bits(HDC hdc, HBITMAP bitmap, int width, int height, int *stride)
+{
+    char buffer[FIELD_OFFSET(BITMAPINFO, bmiColors[256])];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    BYTE *bits;
+
+    *stride = (width + 31) / 32 * 4;
+    if (!(bits = malloc(*stride * height))) return NULL;
+    init_bitmap_info(info, width, height, 1);
+    if (!NtGdiGetDIBitsInternal(hdc, bitmap, 0, height, bits, info, DIB_RGB_COLORS, 0, 0))
+    {
+        free(bits);
+        return NULL;
+    }
+    return bits;
+}
+
+static inline BOOL mono_bit(const BYTE *bits, int stride, int x, int y)
+{
+    return (bits[y * stride + x / 8] >> (7 - x % 8)) & 1;
+}
+
+/* The cursor's image as be_window_set_cursor_image() takes it: B, G, R, A, premultiplied.
+ * Pixels Windows would invert are drawn black, as winewayland draws them: app_server cannot
+ * invert. */
+static UINT32 *cursor_pixels(const ICONINFO *info, int *width, int *height)
+{
+    HDC hdc = NtGdiCreateCompatibleDC(0);
+    UINT32 *pixels = NULL;
+    BYTE *mask = NULL;
+    int stride, x, y, count;
+    BITMAP bm;
+
+    if (!NtGdiExtGetObjectW(info->hbmColor ? info->hbmColor : info->hbmMask, sizeof(bm), &bm))
+        goto done;
+    *width = bm.bmWidth;
+    /* A monochrome cursor's mask holds the AND mask above the XOR mask. */
+    *height = info->hbmColor ? bm.bmHeight : bm.bmHeight / 2;
+    if (*width <= 0 || *height <= 0) goto done;
+    count = *width * *height;
+    if (!(pixels = malloc(count * sizeof(*pixels)))) goto done;
+
+    if (info->hbmColor)
+    {
+        char buffer[FIELD_OFFSET(BITMAPINFO, bmiColors[256])];
+        BITMAPINFO *bmi = (BITMAPINFO *)buffer;
+        BOOL has_alpha = FALSE;
+        int i;
+
+        init_bitmap_info(bmi, *width, *height, 32);
+        if (!NtGdiGetDIBitsInternal(hdc, info->hbmColor, 0, *height, pixels, bmi,
+                                    DIB_RGB_COLORS, 0, 0))
+            goto failed;
+        for (i = 0; i < count && !has_alpha; i++) has_alpha = (pixels[i] >> 24) != 0;
+
+        if (has_alpha)
+        {
+            /* Windows cursors carry straight alpha. */
+            for (i = 0; i < count; i++)
+            {
+                UINT32 p = pixels[i], a = p >> 24;
+                if (a == 255) continue;
+                pixels[i] = (a << 24) | (((p >> 16 & 0xff) * a / 255) << 16) |
+                            (((p >> 8 & 0xff) * a / 255) << 8) | ((p & 0xff) * a / 255);
+            }
+        }
+        else
+        {
+            /* No alpha channel: the AND mask says which pixels show. */
+            if (!(mask = get_mono_bits(hdc, info->hbmMask, *width, *height, &stride))) goto failed;
+            for (y = 0; y < *height; y++)
+            {
+                for (x = 0; x < *width; x++)
+                {
+                    UINT32 *p = &pixels[y * *width + x];
+                    if (!mono_bit(mask, stride, x, y)) *p |= 0xff000000;
+                    else if (*p & 0xffffff) *p = 0xff000000;
+                    else *p = 0;
+                }
+            }
+        }
+    }
+    else
+    {
+        if (!(mask = get_mono_bits(hdc, info->hbmMask, *width, *height * 2, &stride))) goto failed;
+        for (y = 0; y < *height; y++)
+        {
+            for (x = 0; x < *width; x++)
+            {
+                BOOL and = mono_bit(mask, stride, x, y);
+                BOOL xor = mono_bit(mask, stride, x, y + *height);
+                UINT32 *p = &pixels[y * *width + x];
+                if (and && !xor) *p = 0;
+                else if (!and && xor) *p = 0xffffffff;
+                else *p = 0xff000000;
+            }
+        }
+    }
+    goto done;
+
+failed:
+    free(pixels);
+    pixels = NULL;
+done:
+    free(mask);
+    NtGdiDeleteObjectApp(hdc);
+    return pixels;
+}
+
+static BOOL is_transparent(const UINT32 *pixels, int count)
+{
+    while (count--) if (*pixels++ >> 24) return FALSE;
+    return TRUE;
+}
+
+/***********************************************************************
+ *           RENKU_SetCursor
+ *
+ * win32u calls this on the thread of the window under the pointer, whenever that window or
+ * its cursor changes (server/queue.c, WM_WINE_SETCURSOR); cursor is 0 while it is hidden.
+ * The pointer belongs to the top-level window's BView, which app_server shows while the
+ * pointer is over it.
+ */
+void RENKU_SetCursor(HWND hwnd, HCURSOR cursor)
+{
+    WCHAR module[MAX_PATH], res[MAX_PATH];
+    UNICODE_STRING module_str = { 0, sizeof(module) - sizeof(WCHAR), module };
+    UNICODE_STRING res_str = { 0, sizeof(res) - sizeof(WCHAR), res };
+    struct be_window *window;
+    ICONINFO info;
+    UINT32 *pixels;
+    int shape, width, height;
+
+    TRACE("hwnd %p cursor %p\n", hwnd, cursor);
+
+    if (!(window = renku_get_be_window(hwnd))) return;
+
+    if (!cursor)
+    {
+        be_window_set_cursor(window, BE_CURSOR_NONE);
+        goto done;
+    }
+    if (!NtUserGetIconInfo(cursor, &info, &module_str, &res_str, NULL, 0))
+    {
+        WARN("no icon info for %p\n", cursor);
+        be_window_set_cursor(window, BE_CURSOR_DEFAULT);
+        goto done;
+    }
+    module[module_str.Length] = 0;  /* in characters (NtUserGetIconInfo) */
+
+    if ((shape = system_shape(module, &res_str)) >= 0)
+    {
+        TRACE("%s %u: system shape %d\n", debugstr_w(module), LOWORD(res_str.Buffer), shape);
+        be_window_set_cursor(window, shape);
+    }
+    else if ((pixels = cursor_pixels(&info, &width, &height)))
+    {
+        TRACE("%dx%d image, hotspot %u,%u\n", width, height, info.xHotspot, info.yHotspot);
+        if (is_transparent(pixels, width * height)) be_window_set_cursor(window, BE_CURSOR_NONE);
+        else be_window_set_cursor_image(window, width, height, info.xHotspot, info.yHotspot, pixels);
+        free(pixels);
+    }
+    else
+    {
+        WARN("could not read the bitmaps of %p\n", cursor);
+        be_window_set_cursor(window, BE_CURSOR_DEFAULT);
+    }
+    if (info.hbmColor) NtGdiDeleteObjectApp(info.hbmColor);
+    if (info.hbmMask) NtGdiDeleteObjectApp(info.hbmMask);
+
+done:
+    be_window_release(window);
+}
