+/* The BWindow of hwnd's top-level window, referenced, or NULL. */
+struct be_window *renku_get_be_window(HWND hwnd)
+{
+    struct renku_win_data *data;
+    struct be_window *window = NULL;
+    HWND root = NtUserGetAncestor(hwnd, GA_ROOT);
+
+    if (!root || !(data = get_win_data(root))) return NULL;
+    if ((window = data->window)) be_window_add_ref(window);
+    release_win_data(data);
+    return window;
+}
