+/* Pointer shapes app_server draws itself (BCursorID in Cursor.h). */
+enum be_cursor_shape
+{
+    BE_CURSOR_NONE,         /* no pointer at all */
+    BE_CURSOR_DEFAULT,
+    BE_CURSOR_I_BEAM,
+    BE_CURSOR_PROGRESS,
+    BE_CURSOR_CROSS_HAIR,
+    BE_CURSOR_MOVE,
+    BE_CURSOR_RESIZE_NWSE,
+    BE_CURSOR_RESIZE_NESW,
+    BE_CURSOR_RESIZE_EW,
+    BE_CURSOR_RESIZE_NS,
+    BE_CURSOR_NOT_ALLOWED,
+    BE_CURSOR_FOLLOW_LINK,
+    BE_CURSOR_HELP,
+    BE_CURSOR_COPY,
+    BE_CURSOR_CREATE_LINK,
+};
